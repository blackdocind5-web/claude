//@version=5
indicator("XAUUSD Scalper — Estructura M3 (Fase 1)", overlay=true, max_lines_count=500, max_labels_count=500)

// ============================================================================
// FASE 1 — Estructura de mercado M3 + sesiones operativas
// Desarrollado para Fabián — sistema discrecional scalper XAUUSD
//
// Qué hace esta fase:
//   1. Detecta altos y bajos M3 mientras el gráfico corre en M1, usando
//      request.security() para traer los datos M3. La detección se basa en
//      "tramos" (rachas de velas M3 del mismo lado, tolerando doji como
//      continuación) -- el alto/bajo M3 se forma en el límite entre dos
//      tramos opuestos consecutivos, y su nivel es el extremo (máximo o
//      mínimo) de TODO el tramo de cada lado, sin importar si la mecha más
//      relevante está en la vela adyacente al límite o varias velas antes
//      o después.
//   2. Dibuja el alto/bajo M3 "activo" como una línea horizontal que se
//      extiende hasta que el precio la toca, o hasta 10 barras M1 sin toque.
//      Mientras el tramo de confirmación sigue extendiéndose, el nivel se
//      actualiza en el mismo trazo (no crea una línea nueva por cada vela).
//   3. Cuando el precio quiebra el nivel, la línea queda marcada:
//        - PUNTEADA = quiebre a favor de la tendencia vigente (continuación)
//        - CONTINUA = quiebre del nivel opuesto (cambio de estructura)
//      y la tendencia interna se actualiza.
//   4. Sombrea el fondo del gráfico durante las sesiones operativas
//      (Pre-NY 07:00-09:00 EST y Asia 20:00-22:00 EST, Lunes a Jueves).
//      La misma condición de sesión se va a reusar en la Fase 3 para
//      bloquear la señal BUY/SELL fuera de estas franjas.
//
// Qué NO hace todavía (viene en fases siguientes, a validar esta primero):
//   - No detecta velas de entrada (envolvente / start) en M1.
//   - No arma el modelo MEC, no calcula SL/TP, no dibuja la señal BUY/SELL.
//   - No aplica el filtro de noticias, límite diario ni PnL semanal.
// ============================================================================

// ---------------------------- INPUTS ----------------------------
grpEstructura = "Estructura M3"
colorPunteada   = input.color(color.new(#787b86, 0), "Línea punteada (continuación)", group=grpEstructura)
colorContinua   = input.color(color.new(#ff5252, 0), "Línea continua (cambio de estructura)", group=grpEstructura)
extensionBarras = input.int(10, "Extensión sin toque (barras M1)", minval=1, group=grpEstructura)
mostrarEtiquetas = input.bool(true, "Mostrar etiquetas Alto M3 / Bajo M3", group=grpEstructura)

grpSesiones = "Sesiones operativas"
mostrarSesiones = input.bool(true, "Sombrear sesiones en el gráfico", group=grpSesiones)
colorPreNY = input.color(color.new(#2962ff, 88), "Color sesión Pre-NY (07-09 EST)", group=grpSesiones)
colorAsia  = input.color(color.new(#ff9800, 88), "Color sesión Asia (20-22 EST)", group=grpSesiones)

// ---------------------------- SESIONES ----------------------------
// Días Pine: 1=Domingo 2=Lunes 3=Martes 4=Miércoles 5=Jueves 6=Viernes 7=Sábado
// Lunes a Jueves = "2345"
sesionPreNYStr = "0700-0900:2345"
sesionAsiaStr  = "2000-2200:2345"

enPreNY = not na(time(timeframe.period, sesionPreNYStr, "America/New_York"))
enAsia  = not na(time(timeframe.period, sesionAsiaStr, "America/New_York"))
enSesionOperativa = enPreNY or enAsia  // <- se reutiliza en Fase 3 para filtrar señales

bgcolor(mostrarSesiones and enPreNY ? colorPreNY : na, title="Sesión Pre-NY")
bgcolor(mostrarSesiones and enAsia  ? colorAsia  : na, title="Sesión Asia")

// ---------------------------- DATOS M3 ----------------------------
[o3, h3, l3, c3, t3] = request.security(syminfo.tickerid, "3", [open, high, low, close, time], lookahead=barmerge.lookahead_off)
nuevaVelaM3 = ta.change(t3) != 0  // se cumple en la primer barra M1 de cada nueva vela M3

// ---------------------------- RASTREADOR DE TRAMOS (RUNS) M3 ----------------------------
// Un "tramo" es una racha de velas M3 consecutivas del mismo lado (alcista o
// bajista); un doji (cierre = apertura) siempre continúa el tramo vigente,
// nunca lo corta. El alto/bajo M3 se forma en el límite entre dos tramos
// opuestos consecutivos, y su nivel es el extremo de TODO el tramo de cada
// lado -- así cubre tanto la mecha más relevante estando varias velas antes
// del límite (tramo ancla largo) como varias velas después (tramo de
// confirmación largo), sin tratarlas como casos distintos.
var string curDir = na       // dirección del tramo vigente: "alcista" | "bajista"
var float curHigh = na
var int   curHighT = na
var float curLow = na
var int   curLowT = na

var string prevDir = na      // dirección del tramo anterior (ya cerrado)
var float prevHigh = na
var int   prevHighT = na
var float prevLow = na
var int   prevLowT = na

esAltoM3 = false
esBajoM3 = false
nivelAlto = float(na)
nivelBajo = float(na)
altoRunInicio = int(na)
bajoRunInicio = int(na)

if nuevaVelaM3
    // la vela que se acaba de cerrar quedó representada, en la barra anterior, por o3[1]/h3[1]/...
    o0 = o3[1]
    h0 = h3[1]
    l0 = l3[1]
    c0 = c3[1]
    t0 = t3[1]
    candleDir = c0 > o0 ? "alcista" : c0 < o0 ? "bajista" : "doji"

    if na(curDir)
        // primera vela direccional del historial: arranca el primer tramo
        if candleDir != "doji"
            curDir := candleDir
            curHigh := h0, curHighT := t0
            curLow := l0, curLowT := t0
    else if candleDir == curDir or candleDir == "doji"
        // continúa el tramo vigente (doji siempre continúa, nunca lo corta)
        if h0 > curHigh
            curHigh := h0, curHighT := t0
        if l0 < curLow
            curLow := l0, curLowT := t0
    else
        // cambio real de dirección: se cierra el tramo vigente, arranca uno nuevo
        prevDir := curDir, prevHigh := curHigh, prevHighT := curHighT, prevLow := curLow, prevLowT := curLowT
        curDir := candleDir
        curHigh := h0, curHighT := t0
        curLow := l0, curLowT := t0

    // Detección de patrón: se reevalúa en CADA vela mientras el tramo de
    // confirmación siga vigente, así el nivel se actualiza si se extiende
    // (ver ejemplo real: alto M3 06:42-06:51 donde la 2da vela bajista de
    // confirmación tenía la mecha más alta, no la 1ra).
    if not na(prevDir) and prevDir != curDir
        if prevDir == "alcista" and curDir == "bajista"
            esAltoM3 := true
            nivelAlto := math.max(prevHigh, curHigh)
            altoRunInicio := prevHighT
        if prevDir == "bajista" and curDir == "alcista"
            esBajoM3 := true
            nivelBajo := math.min(prevLow, curLow)
            bajoRunInicio := prevLowT

// ---------------------------- ESTADO: nivel activo, líneas, tendencia ----------------------------
var line altoLinea = na
var line bajoLinea = na
var float altoM3Activo = na
var float bajoM3Activo = na
var int altoM3Inicio = na
var int bajoM3Inicio = na
var bool altoRoto = false   // ya fue quebrado por el precio -> no se debe re-extender su x2
var bool bajoRoto = false
var string tendencia = "indefinida"  // "alcista" | "bajista" | "indefinida"

maxExtMs = extensionBarras * timeframe.in_seconds("1") * 1000

// -- alto M3 --
if esAltoM3
    if not na(altoM3Inicio) and altoM3Inicio == altoRunInicio
        // el tramo de confirmación se extendió: actualizo el mismo nivel,
        // no creo una línea nueva por cada vela
        altoM3Activo := nivelAlto
        line.set_y1(altoLinea, nivelAlto)
        line.set_y2(altoLinea, nivelAlto)
    else
        if not na(altoLinea) and not altoRoto
            // el anterior nivel, al quedar reemplazado por uno nuevo antes de ser
            // tocado por el precio, solo se prolonga hasta 10 barras M1 desde SU
            // propia formación (no hasta el momento en que aparece el nuevo nivel)
            line.set_x2(altoLinea, int(math.min(time, altoM3Inicio + maxExtMs)))
        altoM3Activo := nivelAlto
        altoM3Inicio := altoRunInicio
        altoRoto := false
        altoLinea := line.new(x1=altoRunInicio, y1=nivelAlto, x2=time, y2=nivelAlto, xloc=xloc.bar_time, color=colorPunteada, style=line.style_dotted, width=1)
        if mostrarEtiquetas
            label.new(bar_index, nivelAlto, "Alto M3", style=label.style_label_down, color=color.new(color.white, 100), textcolor=colorPunteada, size=size.tiny)

// -- bajo M3 --
if esBajoM3
    if not na(bajoM3Inicio) and bajoM3Inicio == bajoRunInicio
        bajoM3Activo := nivelBajo
        line.set_y1(bajoLinea, nivelBajo)
        line.set_y2(bajoLinea, nivelBajo)
    else
        if not na(bajoLinea) and not bajoRoto
            line.set_x2(bajoLinea, int(math.min(time, bajoM3Inicio + maxExtMs)))
        bajoM3Activo := nivelBajo
        bajoM3Inicio := bajoRunInicio
        bajoRoto := false
        bajoLinea := line.new(x1=bajoRunInicio, y1=nivelBajo, x2=time, y2=nivelBajo, xloc=xloc.bar_time, color=colorPunteada, style=line.style_dotted, width=1)
        if mostrarEtiquetas
            label.new(bar_index, nivelBajo, "Bajo M3", style=label.style_label_up, color=color.new(color.white, 100), textcolor=colorPunteada, size=size.tiny)

// -- extender líneas activas hasta 10 barras M1 sin toque --
if not na(altoLinea) and not na(altoM3Activo)
    line.set_x2(altoLinea, int(math.min(time, altoM3Inicio + maxExtMs)))
if not na(bajoLinea) and not na(bajoM3Activo)
    line.set_x2(bajoLinea, int(math.min(time, bajoM3Inicio + maxExtMs)))

// ---------------------------- QUIEBRES: BOS (punteada) / CHoCH (continua) ----------------------------
quiebreAlto = not na(altoM3Activo) and ta.crossover(close, altoM3Activo)
quiebreBajo = not na(bajoM3Activo) and ta.crossunder(close, bajoM3Activo)

if quiebreAlto
    nivelQuebrado = altoM3Activo
    esCambioEstructura = tendencia == "bajista"
    line.set_x2(altoLinea, time)
    line.set_style(altoLinea, esCambioEstructura ? line.style_solid : line.style_dotted)
    line.set_color(altoLinea, esCambioEstructura ? colorContinua : colorPunteada)
    line.set_width(altoLinea, esCambioEstructura ? 2 : 1)
    if mostrarEtiquetas
        label.new(bar_index, nivelQuebrado, esCambioEstructura ? "Cambio de estructura ▲" : "Quiebre alto M3 ▲", style=label.style_label_down, color=esCambioEstructura ? colorContinua : colorPunteada, textcolor=color.white, size=size.tiny)
    tendencia := "alcista"
    altoM3Activo := na
    altoRoto := true

if quiebreBajo
    nivelQuebrado = bajoM3Activo
    esCambioEstructura = tendencia == "alcista"
    line.set_x2(bajoLinea, time)
    line.set_style(bajoLinea, esCambioEstructura ? line.style_solid : line.style_dotted)
    line.set_color(bajoLinea, esCambioEstructura ? colorContinua : colorPunteada)
    line.set_width(bajoLinea, esCambioEstructura ? 2 : 1)
    if mostrarEtiquetas
        label.new(bar_index, nivelQuebrado, esCambioEstructura ? "Cambio de estructura ▼" : "Quiebre bajo M3 ▼", style=label.style_label_up, color=esCambioEstructura ? colorContinua : colorPunteada, textcolor=color.white, size=size.tiny)
    tendencia := "bajista"
    bajoM3Activo := na
    bajoRoto := true

// ---------------------------- PANEL DE ESTADO ----------------------------
var table panel = table.new(position.top_right, 1, 2, border_width=1)
if barstate.islast
    table.cell(panel, 0, 0, "Tendencia: " + tendencia, text_color=color.white, bgcolor=tendencia == "alcista" ? color.new(color.green, 40) : tendencia == "bajista" ? color.new(color.red, 40) : color.new(color.gray, 40))
    table.cell(panel, 0, 1, enSesionOperativa ? (enPreNY ? "Sesión: Pre-NY" : "Sesión: Asia") : "Fuera de sesión", text_color=color.white, bgcolor=enSesionOperativa ? color.new(color.blue, 40) : color.new(color.gray, 70))
