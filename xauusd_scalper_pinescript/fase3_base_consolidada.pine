//@version=5
indicator("XAUUSD Scalper — Base Consolidada (Fases 1+2)", overlay=true, max_lines_count=500, max_labels_count=500)

// ============================================================================
// BASE CONSOLIDADA — une Fase 1 (estructura M3 + sesiones) y Fase 2
// (envolvente + patrón Start) en un solo script. Es el punto de partida de
// la Fase 3 (MEC + SL/TP + señal final), que necesita ambas piezas
// funcionando juntas -- Pine Script no puede hacer que un indicador lea
// datos de otro.
//
// NINGUNA lógica validada se modificó al consolidar -- solo se renombraron
// algunas variables que se repetían entre los 3 archivos originales y se
// evitó recalcular dos veces la clasificación de envolvente (Fase 2b la
// reutiliza de Fase 2a en vez de duplicarla).
//
// Las etiquetas/triángulos de debug de las Fases 2a/2b (envolvente y patrón
// Start sueltos) ya se retiraron del dibujo -- cumplieron su función para
// validar el volumen de cada vela letra por letra contra los gráficos
// reales, pero el cálculo se mantiene intacto porque el motor MEC lo sigue
// necesitando. Estética final: solo el cartel de señal MEC BUY/SELL.
//
// A partir de acá reemplaza a fase1_estructura_m3.pine,
// fase2a_patron_envolvente.pine y fase2b_patron_start.pine -- cargar solo
// este archivo.
// ============================================================================

// ============================================================================
// SECCIÓN 1 — SESIONES OPERATIVAS (Fase 1)
// ============================================================================
grpSesiones = "Sesiones operativas"
mostrarSesiones = input.bool(true, "Sombrear sesiones en el gráfico", group=grpSesiones)
// Escala de grises distinta por sesión (10/09), para diferenciarlas de un
// vistazo -- Pre-NY más clara, NY intermedia, Asia más oscura. Se bajó la
// transparencia de 85 a 78 para que el gris más claro (Pre-NY) no se pierda
// contra el fondo blanco del gráfico.
colorPreNY = input.color(color.new(#cccccc, 78), "Color sesión Pre-NY (07-09 EST)", group=grpSesiones)
colorNY    = input.color(color.new(#a3a3a3, 78), "Color sesión NY (09-11 EST)", group=grpSesiones)
colorAsia  = input.color(color.new(#999999, 78), "Color sesión Asia (20-22 EST)", group=grpSesiones)

// Días Pine: 1=Domingo 2=Lunes 3=Martes 4=Miércoles 5=Jueves 6=Viernes 7=Sábado
// Pre-NY y NY: Lunes a Viernes (2=Lunes ... 6=Viernes) | Asia: Domingo a
// Jueves (1=Domingo ... 5=Jueves)
sesionPreNYStr = "0700-0900:23456"
sesionNYStr    = "0900-1100:23456"
sesionAsiaStr  = "2000-2200:12345"

// Colchón de 15 minutos ANTES de la apertura de Pre-NY y de Asia (10/09):
// Fabián hace un análisis previo a cada sesión y quiere ver la estructura
// M3 ya armada antes de que abra, para anticiparse. Solo afecta el DIBUJO
// de las líneas M3 (Sección 2, dibujarLineasM3) -- no agranda la sesión
// operativa en sí (sombreado, señal BUY/SELL), que sigue arrancando a la
// hora real de cada sesión. NY no lleva colchón propio porque arranca
// justo donde termina Pre-NY, sin hueco que anticipar.
colchonPreNYStr = "0645-0700:23456"
colchonAsiaStr  = "1945-2000:12345"

enPreNY = not na(time(timeframe.period, sesionPreNYStr, "America/New_York"))
enNY    = not na(time(timeframe.period, sesionNYStr, "America/New_York"))
enAsia  = not na(time(timeframe.period, sesionAsiaStr, "America/New_York"))
enColchonPreNY = not na(time(timeframe.period, colchonPreNYStr, "America/New_York"))
enColchonAsia  = not na(time(timeframe.period, colchonAsiaStr, "America/New_York"))
enSesionOperativa = enPreNY or enNY or enAsia  // <- se reutiliza para filtrar la señal final en Fase 3

bgcolor(mostrarSesiones and enPreNY ? colorPreNY : na, title="Sesión Pre-NY")
bgcolor(mostrarSesiones and enNY    ? colorNY    : na, title="Sesión NY")
bgcolor(mostrarSesiones and enAsia  ? colorAsia  : na, title="Sesión Asia")

// ============================================================================
// SECCIÓN 2 — ESTRUCTURA DE MERCADO M3 (Fase 1)
// ============================================================================
grpEstructura = "Estructura M3"
colorPunteada    = input.color(color.new(#787b86, 0), "Línea punteada (continuación)", group=grpEstructura)
colorContinua    = input.color(color.new(color.black, 0), "Línea continua (cambio de estructura)", group=grpEstructura)
extensionBarras  = input.int(10, "Extensión sin toque (barras M1)", minval=1, group=grpEstructura)
limitarLineasASesion = input.bool(true, "Dibujar líneas M3 solo durante sesiones + colchón de 15min antes de Pre-NY/Asia (más historial dentro del cupo de 500 líneas)", group=grpEstructura)
mostrarDebugM3 = input.bool(false, "DEBUG temporal: valor exacto de altoM3Activo/bajoM3Activo bar a bar (Ventana de Datos)", group=grpEstructura)

// UMBRAL_QUIEBRE (declarado acá, no en la Sección 6 -- ver por qué en
// quiebreAlto/quiebreBajo más abajo) -- default 0,005% (mitad del 0,01%
// original), no 0,01% literal. Fabián mide este volumen con la herramienta
// "rango de precios" de TradingView, que redondea a 2 decimales -- un
// volumen real de 0,00742% ya le aparece como "0,01%" en pantalla,
// indistinguible de un 0,01000% exacto. Bajar el umbral a la mitad cubre
// todo lo que esa herramienta redondearía hacia "0,01%". Caso real que lo
// motivó: BUY 02/09 07:12, volumen real 0,00742% (nivel 4.315,905 -> cierre
// 4.316,225).
UMBRAL_QUIEBRE = input.float(0.00005, "Umbral mínimo de quiebre/Continuación (rango de precios redondea a 2 decimales)", minval=0, maxval=0.001, step=0.00001, group="Modelo MEC")

// Hasta el 11/09 esto se armaba con request.security(syminfo.tickerid, "3",
// ...) y se leía t3[1]/t3[2]/t3[3]. Se abandonó por completo: se probó con
// dos casos reales (BUY 11/09 09:28 NY, SELL 09/09 08:25 Pre-NY) que
// request.security() podía tardar bastante MÁS de lo que ese lookback de 3
// velas M3 cubría en reflejar el cierre real de una vela M3 -- un lag
// impredecible, no una cantidad fija de velas salteadas, así que ningún
// lookback por más grande que fuera iba a ser una solución robusta.
//
// Fix real (11/09): construir la vela M3 A MANO, acumulando OHLC desde las
// propias velas M1 del gráfico, usando timeframe.change("3") -- función
// nativa de Pine pensada exactamente para "saber cuándo arrancó un período
// de un timeframe mayor" a partir del timeframe actual, sin request.security
// ni repintado. Con esto la vela M3 queda cerrada y procesada en el MISMO
// instante en que el M1 entra al siguiente bloque de 3 minutos -- cero lag
// adicional, cero dependencia de cómo TradingView decide exponer un
// timeframe secundario. También elimina la necesidad de la guardia
// anti-duplicados/replay (ultimoT0Procesado): acá cada vela M3 se procesa
// UNA sola vez, exactamente cuando cierra, nunca más ni menos.
nuevaVelaM3 = timeframe.change("3")

var float m3Open = na
var float m3High = na
var float m3Low = na
var float m3Close = na
var int   m3OpenTime = na

var string curDir = na
var float curHigh = na
var int   curHighT = na
var float curLow = na
var int   curLowT = na

var string prevDir = na
var float prevHigh = na
var int   prevHighT = na
var float prevLow = na
var int   prevLowT = na

// procesarVelaM3: corre UNA vela M3 (apertura o0, máximo h0, mínimo l0,
// cierre c0, hora de apertura t0) por el motor de tramos.
//
// OJO -- restricción real de Pine v5 (no lo que yo había asumido antes):
// una función definida con `=>` NO puede reasignar (:=) variables del
// scope GLOBAL, ni siquiera si son `var` (error real de compilación:
// "Cannot modify global variable 'curDir' in function"). Por eso acá la
// función NO toca curDir/curHigh/.../prevLowT directamente -- recibe el
// estado actual como parámetros (sufijo In) y DEVUELVE el estado nuevo
// (sufijo Out); quien la llama (scope global, más abajo) es quien hace
// `curDir := ...` etc. con el resultado.
procesarVelaM3(o0, h0, l0, c0, t0, dirIn, highIn, highTIn, lowIn, lowTIn, prevDirIn, prevHighIn, prevHighTIn, prevLowIn, prevLowTIn) =>
    candleDir = c0 > o0 ? "alcista" : c0 < o0 ? "bajista" : "doji"
    esAltoLocal = false
    esBajoLocal = false
    nivelAltoLocal = float(na)
    nivelBajoLocal = float(na)
    altoRunInicioLocal = int(na)
    bajoRunInicioLocal = int(na)

    dirOut = dirIn
    highOut = highIn
    highTOut = highTIn
    lowOut = lowIn
    lowTOut = lowTIn
    prevDirOut = prevDirIn
    prevHighOut = prevHighIn
    prevHighTOut = prevHighTIn
    prevLowOut = prevLowIn
    prevLowTOut = prevLowTIn

    if na(dirIn)
        if candleDir != "doji"
            dirOut := candleDir
            highOut := h0
            highTOut := t0
            lowOut := l0
            lowTOut := t0
    else if candleDir == dirIn or candleDir == "doji"
        if h0 > highIn
            highOut := h0
            highTOut := t0
        if l0 < lowIn
            lowOut := l0
            lowTOut := t0
    else
        prevDirOut := dirIn
        prevHighOut := highIn
        prevHighTOut := highTIn
        prevLowOut := lowIn
        prevLowTOut := lowTIn
        dirOut := candleDir
        highOut := h0
        highTOut := t0
        lowOut := l0
        lowTOut := t0

    if not na(prevDirOut) and prevDirOut != dirOut
        if prevDirOut == "alcista" and dirOut == "bajista"
            esAltoLocal := true
            nivelAltoLocal := math.max(prevHighOut, highOut)
            altoRunInicioLocal := prevHighTOut
        if prevDirOut == "bajista" and dirOut == "alcista"
            esBajoLocal := true
            nivelBajoLocal := math.min(prevLowOut, lowOut)
            bajoRunInicioLocal := prevLowTOut

    [dirOut, highOut, highTOut, lowOut, lowTOut, prevDirOut, prevHighOut, prevHighTOut, prevLowOut, prevLowTOut, esAltoLocal, esBajoLocal, nivelAltoLocal, nivelBajoLocal, altoRunInicioLocal, bajoRunInicioLocal]

esAltoM3 = false
esBajoM3 = false
nivelAlto = float(na)
nivelBajo = float(na)
altoRunInicio = int(na)
bajoRunInicio = int(na)

// nuevaVelaM3 (timeframe.change) se dispara en la PRIMERA vela M1 del
// período M3 que recién arranca -- en ese preciso instante, m3Open/High/
// Low/Close/OpenTime todavía tienen el estado ACUMULADO del período M3
// anterior (que recién terminó de cerrar en la vela M1 previa), así que acá
// es el momento exacto de correrlo por el motor de tramos, ANTES de
// reiniciar el acumulador con los datos de esta vela nueva. `not
// na(m3OpenTime)` solo evita procesar en el arranque del gráfico, cuando
// todavía no se acumuló ningún período M3 completo.
if nuevaVelaM3 and not na(m3OpenTime)
    [d, hh, hT, ll, lT, pD, pH, pHT, pL, pLT, esA, esB, nA, nB, arI, brI] = procesarVelaM3(m3Open, m3High, m3Low, m3Close, m3OpenTime, curDir, curHigh, curHighT, curLow, curLowT, prevDir, prevHigh, prevHighT, prevLow, prevLowT)
    curDir := d
    curHigh := hh
    curHighT := hT
    curLow := ll
    curLowT := lT
    prevDir := pD
    prevHigh := pH
    prevHighT := pHT
    prevLow := pL
    prevLowT := pLT
    if esA
        esAltoM3 := true
        nivelAlto := nA
        altoRunInicio := arI
    if esB
        esBajoM3 := true
        nivelBajo := nB
        bajoRunInicio := brI

// acumulación del período M3 en curso: si arrancó uno nuevo, se reinicia con
// los valores de esta vela; si no, se extiende con el máximo/mínimo/cierre
if nuevaVelaM3
    m3Open := open
    m3High := high
    m3Low := low
    m3Close := close
    m3OpenTime := time
else
    m3High := math.max(m3High, high)
    m3Low := math.min(m3Low, low)
    m3Close := close

var line altoLinea = na
var line bajoLinea = na
var float altoM3Activo = na
var float bajoM3Activo = na
var int altoM3Inicio = na
var int bajoM3Inicio = na
var bool altoRoto = false
var bool bajoRoto = false
var bool altoLineaActiva = false  // hay una línea DIBUJADA para el altoM3Activo vigente -- nace/muere con la sesión operativa, el NIVEL en sí (altoM3Activo) sigue existiendo igual
var bool bajoLineaActiva = false
var string tendencia = "indefinida"  // "alcista" | "bajista" | "indefinida"

// altoM3Bloqueado/bajoM3Bloqueado (15/09): el candidato a CAMBIO DE
// ESTRUCTURA (el nivel del lado OPUESTO a `tendencia`, el que si se rompe
// genera un CHoCH) es UNO SOLO y no se mueve -- confirmado por Fabián. Hasta
// el 14/09 el código no distinguía esto: CUALQUIER pivote nuevo del mismo
// tipo (esAltoM3/esBajoM3) reemplazaba a altoM3Activo/bajoM3Activo sin
// chequear si el anterior ya se había roto, aunque ese anterior siguiera
// vigente y sin quebrar. Caso real que lo destapó: SELL 14/09 20:04 (Asia)
// que no disparó -- el bajo M3 real de las 19:36-19:42 (4.288,230, el
// candidato correcto a CHoCH bajista, confirmado por Fabián contra el M3 del
// gráfico y contra una versión anterior del indicador que SÍ lo reconocía)
// fue silenciosamente reemplazado por un bajo M3 posterior (4.287,365/
// 4.287,360, visto en el panel DEBUG) antes de que 4.288,230 tuviera
// oportunidad de romperse -- cuando el precio efectivamente lo rompió a las
// 19:53 (cierre 4.287,820, supera tanto el nivel crudo como el margen de
// UMBRAL_QUIEBRE), el código ya no lo estaba vigilando, y recién detectó
// estructura bajista mucho después, con la vela de las 20:04 clasificada
// como BOS en vez del verdadero CHoCH.
//
// Fix: mientras `tendencia` es "alcista", el lado BAJO es el candidato a
// CHoCH y queda BLOQUEADO (bajoM3Bloqueado=true) apenas se fija el primer
// bajo M3 tras el último evento de reseteo -- los bajos M3 que se formen
// después NO lo reemplazan (se grafican punteados, ver más abajo) hasta que
// ocurra uno de los dos eventos que lo resuelven: (1) se rompe con volumen
// válido -- confirma el CHoCH, tendencia pasa a "bajista" -- o (2) se rompe
// antes un alto M3 A FAVOR de la tendencia alcista vigente (un BOS) --
// demuestra que el retroceso que generó este candidato fue falso, se
// descarta y se vuelve a buscar un candidato nuevo desde cero. Simétrico
// para el lado ALTO cuando `tendencia` es "bajista". Mientras `tendencia` es
// "indefinida" (arranque del gráfico) ningún lado se bloquea, igual que
// antes.
var bool altoM3Bloqueado = false
var bool bajoM3Bloqueado = false

// altoM3Reciente/bajoM3Reciente (15/09): altoM3Activo/bajoM3Activo pasaron a
// ser el candidato BLOQUEADO a cambio de estructura (ver arriba) -- pero el
// SL/TP (Sección 6B) necesita el pivote M3 MÁS RECIENTE como referencia
// ("el último Alto/Bajo M3 activo" = la resistencia/soporte sin romper más
// cercana a la entrada), no el candidato viejo que quedó congelado
// esperando resolverse. Son dos roles distintos que hasta ahora compartían
// la misma variable por casualidad. Caso real que lo destapó: SELL 14/09
// 20:24 -- con el fix del candidato bloqueado, el SL se armó contra el Alto
// M3 de ~19:00 (4.297,53, el candidato bloqueado, tendencia ya era bajista
// desde antes) en vez del Alto M3 real más cercano a la entrada (4.289,225,
// formado ~20:00) -- un SL mucho más lejos del que corresponde. Estas dos
// variables se actualizan SIEMPRE que se forma un pivote nuevo (esAltoM3/
// esBajoM3), esté o no bloqueado el candidato de estructura.
var float altoM3Reciente = na
var float bajoM3Reciente = na

maxExtMs = extensionBarras * timeframe.in_seconds("1") * 1000

// dibujarLineasM3: el motor interno (altoM3Activo/bajoM3Activo, quiebreAlto/
// quiebreBajo, tendencia, todo lo que el MEC necesita) sigue corriendo las
// 24hs -- acá solo se apaga el DIBUJO de las líneas, que es lo que consume
// el cupo compartido de 500 líneas de TradingView. El interruptor
// (limitarLineasASesion) queda disponible por si hace falta ver la
// estructura completa fuera de esas horas para depurar un caso puntual.
// Incluye el colchón de 15min antes de Pre-NY/Asia (10/09) para que Fabián
// vea la estructura ya armada antes de la apertura y pueda anticiparse.
dibujarLineasM3 = not limitarLineasASesion or enSesionOperativa or enColchonPreNY or enColchonAsia

if esAltoM3
    altoM3Reciente := nivelAlto
    esMismoTramoAlto = not na(altoM3Inicio) and altoM3Inicio == altoRunInicio
    if esMismoTramoAlto
        // no es un pivote nuevo -- es el MISMO tramo (altoRunInicio sin
        // cambiar) ampliando su valor -- se actualiza siempre, esté
        // bloqueado o no, porque sigue siendo el mismo punto, no uno que lo
        // reemplace
        altoM3Activo := nivelAlto
        if altoLineaActiva
            line.set_y1(altoLinea, nivelAlto)
            line.set_y2(altoLinea, nivelAlto)
    else if tendencia == "bajista" and altoM3Bloqueado
        // candidato a CHoCH ya bloqueado (línea continua) -- este alto M3
        // nuevo NO lo reemplaza, solo se grafica punteado como referencia
        if dibujarLineasM3
            line.new(x1=altoRunInicio, y1=nivelAlto, x2=time, y2=nivelAlto, xloc=xloc.bar_time, color=colorPunteada, style=line.style_dotted, width=1)
    else
        if altoLineaActiva and not altoRoto
            line.set_x2(altoLinea, int(math.min(time, altoM3Inicio + maxExtMs)))
        altoM3Activo := nivelAlto
        altoM3Inicio := altoRunInicio
        altoRoto := false
        altoLineaActiva := dibujarLineasM3
        if altoLineaActiva
            altoLinea := line.new(x1=altoRunInicio, y1=nivelAlto, x2=time, y2=nivelAlto, xloc=xloc.bar_time, color=colorPunteada, style=line.style_dotted, width=1)
        if tendencia == "bajista"
            altoM3Bloqueado := true

if esBajoM3
    bajoM3Reciente := nivelBajo
    esMismoTramoBajo = not na(bajoM3Inicio) and bajoM3Inicio == bajoRunInicio
    if esMismoTramoBajo
        // ver comentario en el bloque esAltoM3 de arriba
        bajoM3Activo := nivelBajo
        if bajoLineaActiva
            line.set_y1(bajoLinea, nivelBajo)
            line.set_y2(bajoLinea, nivelBajo)
    else if tendencia == "alcista" and bajoM3Bloqueado
        // candidato a CHoCH ya bloqueado (línea continua) -- este bajo M3
        // nuevo NO lo reemplaza, solo se grafica punteado como referencia --
        // este es exactamente el caso del SELL 14/09 20:04 (ver comentario en
        // la declaración de bajoM3Bloqueado más arriba)
        if dibujarLineasM3
            line.new(x1=bajoRunInicio, y1=nivelBajo, x2=time, y2=nivelBajo, xloc=xloc.bar_time, color=colorPunteada, style=line.style_dotted, width=1)
    else
        if bajoLineaActiva and not bajoRoto
            line.set_x2(bajoLinea, int(math.min(time, bajoM3Inicio + maxExtMs)))
        bajoM3Activo := nivelBajo
        bajoM3Inicio := bajoRunInicio
        bajoRoto := false
        bajoLineaActiva := dibujarLineasM3
        if bajoLineaActiva
            bajoLinea := line.new(x1=bajoRunInicio, y1=nivelBajo, x2=time, y2=nivelBajo, xloc=xloc.bar_time, color=colorPunteada, style=line.style_dotted, width=1)
        if tendencia == "alcista"
            bajoM3Bloqueado := true

// si el nivel ya estaba activo desde antes de entrar en sesión (o justo se
// prendió el interruptor), recién ahora lo dibuja -- arranca la línea en su
// x1 real (altoM3Inicio/bajoM3Inicio), no en la barra actual
if dibujarLineasM3 and not altoLineaActiva and not na(altoM3Activo)
    altoLineaActiva := true
    altoLinea := line.new(x1=altoM3Inicio, y1=altoM3Activo, x2=time, y2=altoM3Activo, xloc=xloc.bar_time, color=colorPunteada, style=line.style_dotted, width=1)
if dibujarLineasM3 and not bajoLineaActiva and not na(bajoM3Activo)
    bajoLineaActiva := true
    bajoLinea := line.new(x1=bajoM3Inicio, y1=bajoM3Activo, x2=time, y2=bajoM3Activo, xloc=xloc.bar_time, color=colorPunteada, style=line.style_dotted, width=1)

if altoLineaActiva and not na(altoM3Activo)
    line.set_x2(altoLinea, int(math.min(time, altoM3Inicio + maxExtMs)))
if bajoLineaActiva and not na(bajoM3Activo)
    line.set_x2(bajoLinea, int(math.min(time, bajoM3Inicio + maxExtMs)))

// Hasta el 14/09 esto era ta.crossover/ta.crossunder SIN margen -- cualquier
// toque mínimo por encima/debajo del nivel ya se daba por "quiebre
// confirmado" (CHoCH/BOS), aunque no superara el mismo umbral
// (UMBRAL_QUIEBRE) que el motor MEC exige más abajo para validar una
// entrada puntual. Eso desalineaba las dos cosas: el nivel se daba por roto
// (la línea dejaba de extenderse, `tendencia` cambiaba) en el primer toque
// débil, y el MEC de ahí en más trataba ese quiebre como CHoCH ya
// confirmado -- permitiendo que la vela que en realidad recién confirmaba
// el quiebre real disparara la señal directo, sin exigirle el pullback +
// continuación nuevos que le corresponden a un CHoCH recién confirmado.
// Caso real que lo destapó: START BUY 08/09 09:54 (Pre-NY) inválida -- el
// Alto M3 en 4.402,92 tuvo un primer toque débil que NO lo superaba con el
// volumen mínimo exigido, pero el código ya lo daba por roto ahí; el nivel
// debía seguir extendiéndose a la derecha hasta que se lo superó
// efectivamente recién a las 09:54, y esa vela debía ser el INICIO de la
// búsqueda de Continuación, no la señal en sí.
// Fix: usar el mismo UMBRAL_QUIEBRE acá -- ya no hace falta ta.crossover
// (semántica de "cruce" entre esta vela y la anterior), porque altoM3Activo/
// bajoM3Activo pasan a `na` en la MISMA vela en que se confirma el quiebre
// (más abajo en este bloque), así que "not na(...)" solo puede ser true
// mientras el nivel sigue sin romperse -- el chequeo de nivel + margen ya
// se comporta como "primera vez que se cumple", sin necesitar el cruce.
//
// PERO (15/09): ese margen SOLO corresponde cuando el quiebre implicaría un
// CHoCH (`tendencia` es la opuesta al lado que se está evaluando) -- un
// cambio de tendencia necesita esa confirmación fuerte para no dispararse
// con un toque débil, tal como probó el caso de AUDUSD arriba. Un BOS
// (`tendencia` YA es ese mismo lado, simple continuación) es un estándar
// mucho más bajo: alcanza con que el precio supere el nivel, aunque sea
// solo con mecha o con un cuerpo menor al margen -- no hace falta volumen
// mínimo para confirmar que la tendencia vigente sigue viva. Antes de este
// fix, un BOS débil (mecha o cuerpo chico) no se reconocía -- esto también
// dejaba sin resolver el candidato bloqueado del lado opuesto (ver
// altoM3Bloqueado/bajoM3Bloqueado más arriba), porque el evento (2) que lo
// invalida ES justamente este BOS. Caso real que lo destapó: PRE-NY 15/09
// en vivo -- el candidato bajo bloqueado en 4.278,725 (07:06) debió haber
// sido reemplazado por el bajo M3 más reciente (4.282,460, 07:54) apenas se
// confirmó un BOS alcista entre esas dos velas, pero el toque real fue más
// débil que el margen y el código no lo reconoció -- la línea continua
// quedó pegada al candidato viejo hasta su quiebre real, mucho más tarde.
quiebreAlto = not na(altoM3Activo) and (tendencia == "bajista" ? close > altoM3Activo * (1 + UMBRAL_QUIEBRE) : high > altoM3Activo)
quiebreBajo = not na(bajoM3Activo) and (tendencia == "alcista" ? close < bajoM3Activo * (1 - UMBRAL_QUIEBRE) : low < bajoM3Activo)

// se reutiliza en Fase 3 para saber si el último quiebre fue continuación (BOS) o cambio de estructura (CHoCH)
var bool ultimoQuiebreFueCambioEstructura = false

// alcance global (no local a los bloques de abajo) porque la Sección 6 (MEC) también los necesita
esCambioEstructuraAlto = false
esCambioEstructuraBajo = false
nivelQuebradoAlto = float(na)
nivelQuebradoBajo = float(na)
// var (persisten, a diferencia de nivelQuebradoAlto/Bajo de arriba que
// vuelven a na en la siguiente vela) -- respaldo para el cálculo de SL/TP
// (Sección 6B) cuando altoM3Activo/bajoM3Activo está en na en el momento de
// la señal (recién roto, todavía no se formó un pivote nuevo).
var float ultimoAltoQuebrado = na
var float ultimoBajoQuebrado = na

if quiebreAlto
    nivelQuebradoAlto := altoM3Activo
    ultimoAltoQuebrado := altoM3Activo
    esCambioEstructuraAlto := tendencia == "bajista"
    if altoLineaActiva
        line.set_x2(altoLinea, time)
        line.set_style(altoLinea, esCambioEstructuraAlto ? line.style_solid : line.style_dotted)
        line.set_color(altoLinea, esCambioEstructuraAlto ? colorContinua : colorPunteada)
        line.set_width(altoLinea, esCambioEstructuraAlto ? 2 : 1)
    tendencia := "alcista"
    altoM3Activo := na
    altoRoto := true
    altoLineaActiva := false
    ultimoQuiebreFueCambioEstructura := esCambioEstructuraAlto
    // este quiebre resuelve el candidato del lado alto si estaba bloqueado
    // (CHoCH) y, sea CHoCH o BOS, invalida cualquier candidato bajo
    // pendiente -- empieza a buscarse uno nuevo desde cero (ver
    // altoM3Bloqueado/bajoM3Bloqueado más arriba)
    altoM3Bloqueado := false
    bajoM3Bloqueado := false

if quiebreBajo
    nivelQuebradoBajo := bajoM3Activo
    ultimoBajoQuebrado := bajoM3Activo
    esCambioEstructuraBajo := tendencia == "alcista"
    if bajoLineaActiva
        line.set_x2(bajoLinea, time)
        line.set_style(bajoLinea, esCambioEstructuraBajo ? line.style_solid : line.style_dotted)
        line.set_color(bajoLinea, esCambioEstructuraBajo ? colorContinua : colorPunteada)
        line.set_width(bajoLinea, esCambioEstructuraBajo ? 2 : 1)
    tendencia := "bajista"
    bajoM3Activo := na
    bajoRoto := true
    bajoLineaActiva := false
    ultimoQuiebreFueCambioEstructura := esCambioEstructuraBajo
    // ver comentario simétrico en el bloque quiebreAlto de arriba
    bajoM3Bloqueado := false
    altoM3Bloqueado := false

// DEBUG TEMPORAL (11/09): valor EXACTO de altoM3Activo/bajoM3Activo en CADA
// vela M1, para leer directo en la Ventana de Datos sin depender de
// etiquetas ni de mi interpretación -- se agrega para investigar el caso
// del BUY 11/09 09:28 (NY), donde el SL usó un Bajo M3 viejo (4.381,420)
// en vez del correcto (4.380,605) pese a que el rastreo manual del código
// dice que debería haberse actualizado antes de las 09:28.
plot(mostrarDebugM3 ? altoM3Activo : na, title="DEBUG altoM3Activo", color=color.blue, style=plot.style_circles, linewidth=2)
plot(mostrarDebugM3 ? bajoM3Activo : na, title="DEBUG bajoM3Activo", color=color.purple, style=plot.style_circles, linewidth=2)
// DEBUG (15/09): altoM3Reciente/bajoM3Reciente -- el pivote MÁS RECIENTE
// (usado para SL/TP), distinto de altoM3Activo/bajoM3Activo (el candidato
// bloqueado a cambio de estructura) mientras hay un candidato pendiente sin
// resolver -- ver comentario en su declaración (Sección 2).
plot(mostrarDebugM3 ? altoM3Reciente : na, title="DEBUG altoM3Reciente", color=color.teal, style=plot.style_circles, linewidth=2)
plot(mostrarDebugM3 ? bajoM3Reciente : na, title="DEBUG bajoM3Reciente", color=color.orange, style=plot.style_circles, linewidth=2)

// ============================================================================
// SECCIÓN 3 — CLASIFICADOR DE VELA ENVOLVENTE EN M1 (Fase 2a)
// ============================================================================
// Sin controles visuales propios -- esto fue el clasificador de la Fase 2a,
// útil en su momento para validar letra por letra el volumen de cada vela
// contra los gráficos reales de Fabián. Ya validado, el motor MEC (Sección 6)
// es el único que consume estas variables; no se dibuja nada de esta sección.
//
// TOLERANCIA_CUERPO: margen sobre los cortes de 85%/90% del cuerpo. Fabián
// mide el volumen a ojo con una grilla de Gann dibujada a mano (sin
// decimales) -- exigirle al código una precisión matemática perfecta sobre
// un corte que él mismo definió visualmente es MÁS estricto que el propio
// método que estamos formalizando. No cambia qué es una envolvente (sigue
// exigiendo cuerpo dominante), solo reconoce que ese método de referencia
// no resuelve más allá de este margen. Caso real que lo motivó: vela de
// 30/08 20:35, cuerpo 84,60% -- Fabián la confirmó como Estándar válida.
//
// Martillo exige un cuerpo CHICO (tal como lo indica su nombre): el nivel
// del lado de la apertura tiene que caer en la banda angosta 40%-50% (no
// en cualquier punto >=50%, como era antes) -- confirmado por Fabián el
// 09/09.
//
// Doji: las dos ramas estaban INVERTIDAS desde la Fase 2a -- corregido el
// 09/09. nivelOpen >= 15% (el open queda más lejos del extremo) exige el
// cierre más estricto (90%); nivelOpen < 15% (open ya casi en el extremo)
// se conforma con 85%. Caso real que lo destapó: SELL 31/08 08:25,
// nivelOpen 24,80% (>=15%) exigía cierre >=90%, cerró en 86,64% -- inválida.
// Un nivelOpen por ENCIMA de la banda de Martillo (>50%+TOL) ya NO se
// evalúa como Doji -- ver el techo agregado el 10/09 más abajo.
grpEnvolvente = "Patrón envolvente / Start"
TOLERANCIA_CUERPO = input.float(0.01, "Margen sobre 85%/90% de cuerpo (grilla de Gann a mano)", minval=0, maxval=0.05, step=0.005, group=grpEnvolvente)

rango = high - low
esAlcista = close > open
esBajista = close < open

// -- BUY: 0 = low, 1 = high --
nivelOpenBuy  = rango > 0 ? (open - low) / rango : na
nivelCloseBuy = rango > 0 ? (close - low) / rango : na
cuerpoPctBuy  = nivelCloseBuy - nivelOpenBuy

esEstandarBuy = esAlcista and cuerpoPctBuy >= 0.85 - TOLERANCIA_CUERPO
// Martillo exige un cuerpo CHICO (tal como lo indica su nombre): el extremo
// del cuerpo del lado de la apertura tiene que caer en la banda angosta
// 40%-50%.
esMartilloBuy = esAlcista and not esEstandarBuy and nivelOpenBuy >= 0.40 - TOLERANCIA_CUERPO and nivelOpenBuy <= 0.50 + TOLERANCIA_CUERPO and nivelCloseBuy >= 0.85 - TOLERANCIA_CUERPO
// nivelOpen >= 15% (el open queda más lejos del extremo) exige el cierre
// más estricto (90%); nivelOpen < 15% (open ya casi en el extremo) se
// conforma con 85% -- corregido el 09/09, estaba invertido desde la Fase 2a.
// Techo en 40%-TOL (10/09): un nivelOpen por ENCIMA de la banda de Martillo
// ya NO se evalúa como Doji -- significa que más de la mitad del rango es
// mecha en contra antes de la apertura, la misma forma que la Sección 4
// reconoce como vela de indecisión/pinbar, no una vela envolvente decisiva
// por más lejos que llegue el cierre. Caso real que lo destapó: SELL 10/09
// 08:30, nivelOpen 64,96% y cierre 91,62% (pasaba la regla vieja del 90%)
// con un cuerpo real de apenas 26,66% -- Fabián la identificó a mano como
// pinbar bajista, vela de indecisión del patrón Start confirmado recién en
// la vela siguiente (08:31).
esDojiBuy     = esAlcista and not esEstandarBuy and not esMartilloBuy and nivelOpenBuy < 0.40 - TOLERANCIA_CUERPO and ((nivelOpenBuy >= 0.15 and nivelCloseBuy >= 0.90 - TOLERANCIA_CUERPO) or (nivelOpenBuy < 0.15 and nivelCloseBuy >= 0.85 - TOLERANCIA_CUERPO))
esEnvolventeBuy = esEstandarBuy or esMartilloBuy or esDojiBuy

// -- SELL: 0 = high, 1 = low --
nivelOpenSell  = rango > 0 ? (high - open) / rango : na
nivelCloseSell = rango > 0 ? (high - close) / rango : na
cuerpoPctSell  = nivelCloseSell - nivelOpenSell

esEstandarSell = esBajista and cuerpoPctSell >= 0.85 - TOLERANCIA_CUERPO
esMartilloSell = esBajista and not esEstandarSell and nivelOpenSell >= 0.40 - TOLERANCIA_CUERPO and nivelOpenSell <= 0.50 + TOLERANCIA_CUERPO and nivelCloseSell >= 0.85 - TOLERANCIA_CUERPO
esDojiSell     = esBajista and not esEstandarSell and not esMartilloSell and nivelOpenSell < 0.40 - TOLERANCIA_CUERPO and ((nivelOpenSell >= 0.15 and nivelCloseSell >= 0.90 - TOLERANCIA_CUERPO) or (nivelOpenSell < 0.15 and nivelCloseSell >= 0.85 - TOLERANCIA_CUERPO))
esEnvolventeSell = esEstandarSell or esMartilloSell or esDojiSell

// pullback inmediato (1 vela contraria antes de la vela envolvente misma) -- distinto del pullback del patrón Start
// <= / >= (14/09), no </> estrictos -- una vela de cuerpo CERO (open==close,
// doji perfecto) no es "a favor" de ninguna dirección, así que tampoco
// debería quedar excluida de contar como pullback. Con el estricto anterior,
// una vela con open==close exacto nunca cumplía ni pullbackBuy ni
// pullbackSell. Cambio puramente aditivo: solo agrega el caso borde
// open==close, nunca saca un caso que antes ya calificaba.
pullbackEnvolventeBuy  = close[1] <= open[1]
pullbackEnvolventeSell = close[1] >= open[1]

candidataEnvolventeBuy  = esEnvolventeBuy  and pullbackEnvolventeBuy
candidataEnvolventeSell = esEnvolventeSell and pullbackEnvolventeSell

tipoEnvBuy  = esEstandarBuy  ? "Estándar" : esMartilloBuy  ? "Martillo" : esDojiBuy  ? "Doji" : na
tipoEnvSell = esEstandarSell ? "Estándar" : esMartilloSell ? "Martillo" : esDojiSell ? "Doji" : na

// ============================================================================
// SECCIÓN 4 — PATRÓN START: indecisión + envolvente de continuación (Fase 2b)
// ============================================================================
// Sin controles visuales propios, misma razón que la Sección 3.
rangoInd = high[1] - low[1]
TOLERANCIA = 0.0001  // 0,01%

// -- vela de indecisión (candle[1]) medida en marco D=BUY --
nivelOpenIndBuy  = rangoInd > 0 ? (open[1] - low[1]) / rangoInd : na
nivelCloseIndBuy = rangoInd > 0 ? (close[1] - low[1]) / rangoInd : na
cuerpoIndBuy = math.abs(nivelCloseIndBuy - nivelOpenIndBuy)
// esMartilloIndBuy (14/09, ampliado): además de la forma clásica (apertura
// en la banda 40%-50%, cierre >=85%), también cuenta como Martillo la forma
// ASIMÉTRICA -- mecha chica del lado de la apertura (<15%) pero el cuerpo ya
// pasó la mitad del rango (cierre >50%). Sin esto, una vela así se colaba
// como "indecisión" válida cuando en realidad ya es decisiva. Caso real que
// lo destapó: BUY AUDUSD 10/09 20:43 -- la vela de indecisión (20:42) abrió
// en 10% y cerró en 60%, decisiva por este criterio, pero el código la
// dejaba pasar. Es un chequeo 100% por porcentaje (no depende del
// instrumento ni de su escala de precio), así que corrige por igual
// cualquier activo, oro incluido.
esMartilloIndBuy = (nivelOpenIndBuy >= 0.40 - TOLERANCIA_CUERPO and nivelOpenIndBuy <= 0.50 + TOLERANCIA_CUERPO and nivelCloseIndBuy >= 0.85 - TOLERANCIA_CUERPO) or (nivelOpenIndBuy < 0.15 and nivelCloseIndBuy > 0.50 - TOLERANCIA_CUERPO)
esIndecisionBuy = cuerpoIndBuy <= 0.50 + TOLERANCIA and not esMartilloIndBuy

wickContraBuy = math.min(nivelOpenIndBuy, nivelCloseIndBuy)
wickFavorBuy  = 1 - math.max(nivelOpenIndBuy, nivelCloseIndBuy)
tipoIndBuy = esIndecisionBuy ? (math.abs(wickContraBuy - wickFavorBuy) <= 0.15 ? "Doji" : "Pinbar") : na

// -- vela de indecisión (candle[1]) medida en marco D=SELL --
nivelOpenIndSell  = rangoInd > 0 ? (high[1] - open[1]) / rangoInd : na
nivelCloseIndSell = rangoInd > 0 ? (high[1] - close[1]) / rangoInd : na
cuerpoIndSell = math.abs(nivelCloseIndSell - nivelOpenIndSell)
// espejo de esMartilloIndBuy -- ver comentario arriba
esMartilloIndSell = (nivelOpenIndSell >= 0.40 - TOLERANCIA_CUERPO and nivelOpenIndSell <= 0.50 + TOLERANCIA_CUERPO and nivelCloseIndSell >= 0.85 - TOLERANCIA_CUERPO) or (nivelOpenIndSell < 0.15 and nivelCloseIndSell > 0.50 - TOLERANCIA_CUERPO)
esIndecisionSell = cuerpoIndSell <= 0.50 + TOLERANCIA and not esMartilloIndSell

wickContraSell = math.min(nivelOpenIndSell, nivelCloseIndSell)
wickFavorSell  = 1 - math.max(nivelOpenIndSell, nivelCloseIndSell)
tipoIndSell = esIndecisionSell ? (math.abs(wickContraSell - wickFavorSell) <= 0.15 ? "Doji" : "Pinbar") : na

// pullback del patrón Start: candle[2] contrario a D (distinto de pullbackEnvolventeBuy/Sell, que mira candle[1])
// <= / >= (14/09) -- mismo motivo que pullbackEnvolventeBuy/Sell más arriba.
// Caso real que lo destapó: SELL BTC 09/09 20:20h inválido -- la vela de
// pullback (20:18h) abrió y cerró exactamente en 78.242 (cuerpo cero), y el
// estricto `close[2] > open[2]` nunca se cumple con una igualdad exacta.
// TradingView ya la pinta como vela válida (mecha sin cuerpo) aunque no
// tenga cuerpo -- el código debía reconocerla igual.
pullbackStartBuy  = close[2] <= open[2]
pullbackStartSell = close[2] >= open[2]

// invalidación: 3 velas consecutivas del mismo color
mismoColor3 = (close > open and close[1] > open[1] and close[2] > open[2]) or (close < open and close[1] < open[1] and close[2] < open[2])

esStartBuy  = esEnvolventeBuy  and esIndecisionBuy  and pullbackStartBuy  and not mismoColor3
esStartSell = esEnvolventeSell and esIndecisionSell and pullbackStartSell and not mismoColor3

// ============================================================================
// SECCIÓN 6 — MODELO MEC (Fase 3)
// ============================================================================
// mecListo = true  -> ya hubo al menos una Continuación confirmada desde el
//   último reset (la estructura está habilitada para buscar entradas a favor
//   de la `tendencia` vigente).
//
// Regla general ("todos los niveles a la izquierda", confirmada por
// Fabián): para que UNA ENTRADA PUNTUAL sea válida no alcanza con que
// `mecListo` esté en true -- esa vela concreta (envolvente o Start) tiene
// que superar, ella misma, el nivel más reciente con el umbral configurado
// (`UMBRAL_QUIEBRE`, default 0,005%) de volumen. Por
// eso `extremoQuiebre` es un nivel que se extiende con la mecha de TODA
// vela M1 (a favor o en contra, la haya superado o no) SIEMPRE, corra o no
// una búsqueda activa -- así el nivel sigue creciendo con la tendencia
// aunque `mecListo` ya esté en true.
//
// Reset COMPLETO (pierde `mecListo` y hay que rearmar `huboPullbackEnBusqueda`
// desde cero) SOLO ante un CHoCH real -- cuando `esCambioEstructuraAlto` o
// `esCambioEstructuraBajo` es true, es decir la tendencia efectivamente
// cambia. Un BOS (mismo quiebre, pero la tendencia sigue igual) o la
// formación de un Alto/Bajo M3 nuevo EN LA MISMA dirección NO resetean nada
// -- el nivel ya se extiende solo, vela a vela, con el bloque de abajo.
// Corregido el 09/09: antes cualquier BOS (no solo el CHoCH) reseteaba todo,
// lo cual en una tendencia sana con varios BOS seguidos (normal, sin cambio
// real de estructura) tiraba abajo `mecListo` una y otra vez, dejando el
// motor "esperando Continuación" casi toda la sesión en vez de sostenerse
// listo. Caso real que lo destapó: BUY 03/09 20:55, pullback largo y mixto
// con varios BOS internos sin cambio de tendencia real.
// (El primerísimo quiebre de la sesión, viniendo de tendencia "indefinida",
// también inicializa el nivel aunque no sea técnicamente un CHoCH.)
//
// Confirmación de Continuación: una vez que hubo al menos 1 vela de
// pullback desde el reset, la primera vela a favor que cierra superando
// `extremoQuiebre` con el umbral configurado marca `mecListo := true`.
//
// Validación de CADA entrada: en TODAS las velas (haya o no búsqueda de
// pullback en curso) se recalcula si esta vela puntual superó el nivel
// vigente (`superaNivelAhora`) ANTES de que su propia mecha lo actualice.
// La señal final exige `mecListo` (ya hubo una Continuación válida en este
// tramo) Y `superaNivelAhora` en ESA vela puntual -- una reentrada
// posterior no hereda gratis la validación original.
//
// UMBRAL_QUIEBRE ahora se declara en la Sección 2 (mismo umbral, mismo
// grupo "Modelo MEC" en el panel de configuración) -- lo necesita
// quiebreAlto/quiebreBajo, que corre antes que esta sección.
grpMEC = "Modelo MEC"
mostrarSenalMEC = input.bool(true, "Mostrar cartel de señal final BUY/SELL", group=grpMEC)
mostrarZonaBusquedaMEC = input.bool(false, "Sombrear zona de búsqueda de Continuación (debug)", group=grpMEC)

var bool huboPullbackEnBusqueda = false
var float extremoQuiebre = na
var bool mecListo = false

// "or na(extremoQuiebre)" cubre el primerísimo quiebre de la sesión: viniendo
// de tendencia "indefinida" (nunca hubo un lado opuesto establecido),
// esCambioEstructuraAlto/Bajo da false, pero igual hay que inicializar el
// nivel esa primera vez o el motor nunca arrancaría.
//
// El reset toma el máximo/mínimo de las últimas 4 velas M1 (esta + 3 para
// atrás), no solo la vela actual -- porque la vela M3 que contiene el
// quiebre real recién queda "cerrada y reconocida" por el código hasta 3
// velas M1 después (la estructura M3 agrupa de a 3 minutos, y solo se
// procesa cuando el gráfico M1 llega al siguiente bloque). Sin este
// colchón, `extremoQuiebre` arrancaba con el mínimo/máximo de la vela
// donde el código RECONOCE el quiebre (tarde), no de la vela que
// realmente lo originó -- un nivel mucho más fácil de superar, que
// generaba señales falsas. Caso real que lo destapó: SELL 07/09 20:47 --
// el quiebre real fue en la vela de las 20:43 (mínimo 4.418,830), pero el
// código recién lo reconoció en la de las 20:45 (mínimo 4.420,620,
// bastante más alto), y la vela de las 20:47 superaba ese segundo nivel
// sin superar el real.
if quiebreAlto and (esCambioEstructuraAlto or na(extremoQuiebre))
    huboPullbackEnBusqueda := false
    extremoQuiebre := math.max(math.max(high, high[1]), math.max(high[2], high[3]))
    mecListo := false

if quiebreBajo and (esCambioEstructuraBajo or na(extremoQuiebre))
    huboPullbackEnBusqueda := false
    extremoQuiebre := math.min(math.min(low, low[1]), math.min(low[2], low[3]))
    mecListo := false

esVelaAFavor = false
esVelaEnContra = false
superaNivelAhora = false

if tendencia != "indefinida" and not na(extremoQuiebre)
    esVelaAFavor := tendencia == "alcista" ? close > open : close < open
    esVelaEnContra := tendencia == "alcista" ? close < open : close > open

    umbral = tendencia == "alcista" ? extremoQuiebre * (1 + UMBRAL_QUIEBRE) : extremoQuiebre * (1 - UMBRAL_QUIEBRE)
    superaNivelAhora := tendencia == "alcista" ? close > umbral : close < umbral

    if esVelaEnContra
        huboPullbackEnBusqueda := true

    // una vez que ya hubo al menos 1 vela de pullback, la primera vela a
    // favor que supera el nivel vigente confirma la Continuación
    if huboPullbackEnBusqueda and esVelaAFavor and superaNivelAhora
        mecListo := true

    // el nivel se extiende SIEMPRE con la mecha de esta vela, haya
    // superado o no -- pasa a ser el próximo "nivel a la izquierda" a
    // batir, incluso después de que mecListo ya esté en true
    extremoQuiebre := tendencia == "alcista" ? math.max(extremoQuiebre, high) : math.min(extremoQuiebre, low)

esperandoContinuacion = tendencia != "indefinida" and not mecListo

// -- Señal MEC "en bruto": el SL/TP se calcula más abajo (Sección 6B), pero
//    todavía sin control de "una señal por vela hasta invalidarse" -- eso es
//    el próximo incremento de la Fase 3 parte 2.
mecBuyBruto  = mecListo and tendencia == "alcista" and superaNivelAhora and (candidataEnvolventeBuy  or esStartBuy)
mecSellBruto = mecListo and tendencia == "bajista" and superaNivelAhora and (candidataEnvolventeSell or esStartSell)

// filtro de sesión: el motor MEC sigue corriendo las 24hs por detrás (para no
// perder el hilo de la estructura), pero la señal solo se MUESTRA dentro de
// Pre-NY / NY / Asia
mecBuySenal  = mecBuyBruto  and enSesionOperativa
mecSellSenal = mecSellBruto and enSesionOperativa

// bgcolor() no puede llamarse dentro de un `if` en Pine -- la condicionalidad
// va en la expresión de color, no envolviendo la llamada
bgcolor(mostrarZonaBusquedaMEC and esperandoContinuacion ? color.new(color.yellow, 85) : na, title="Esperando Continuación MEC (debug)")

// ============================================================================
// SECCIÓN 6B — CÁLCULO DE SL/TP (Fase 3 parte 2)
// ============================================================================
// SL: distancia entre la entrada (cierre de la vela de señal) y el último
// Alto/Bajo M3 ACTIVO -- resistencia sin romper para un SELL (altoM3Activo),
// soporte sin romper para un BUY (bajoM3Activo). Si ese nivel no está
// disponible (caso borde, recién roto y todavía no se formó un pivote
// nuevo) se usa el último quebrado (ultimoAltoQuebrado/ultimoBajoQuebrado,
// que sí persisten entre velas) como referencia de respaldo.
//
// Si la distancia cruda supera un umbral (UMBRAL_SL_PCT, en % del precio de
// entrada) se reduce multiplicándola por REDUCCION_SL -- una distancia
// demasiado grande no es operable para scalping. El umbral va en PORCENTAJE,
// no en ticks/pips fijos, para que el mismo indicador sirva en cualquier
// instrumento (oro, índices, forex, cripto) sin tocar código -- a pedido de
// Fabián, pensando en reusar este motor en otros activos.
//
// TP: RR_TP × la distancia FINAL del SL (ya reducida si correspondía), en la
// dirección favorable.
//
// Validado letra por letra (11/09) contra la operación real de Fabián del
// 23/08 20:24h (Asia, SELL): entrada 4.612,435, Alto M3 4.640,935 ->
// distancia cruda 28,500 (0,6179% del precio, supera el umbral 0,46%) ->
// distancia final 28,500×0,6 = 17,100 -> SL calculado 4.629,535 (real:
// 4.629,515) y TP calculado 4.597,045 (real: 4.597,145) -- diferencia
// mínima por redondeo de Fabián, fórmula confirmada tal cual.
grpSLTP = "SL / TP"
mostrarSLTP = input.bool(true, "Mostrar SL/TP calculados en cada señal (verificación, antes de la ficha final)", group=grpSLTP)
UMBRAL_SL_PCT = input.float(0.46, "Umbral de distancia SL para reducción (% del precio de entrada)", minval=0, step=0.01, group=grpSLTP)
REDUCCION_SL = input.float(0.60, "Multiplicador de la distancia SL al superar el umbral (0,60 = reduce 40%)", minval=0.1, maxval=1, step=0.05, group=grpSLTP)
RR_TP = input.float(0.90, "Relación riesgo:beneficio del TP (TP = RR × distancia SL final)", minval=0.1, step=0.05, group=grpSLTP)

// altoM3Reciente/bajoM3Reciente (15/09), no altoM3Activo/bajoM3Activo -- ver
// comentario en su declaración (Sección 2). El SL quiere el pivote más
// cercano a la entrada, no el candidato bloqueado a cambio de estructura.
nivelSLBuy  = na(bajoM3Reciente) ? ultimoBajoQuebrado : bajoM3Reciente
nivelSLSell = na(altoM3Reciente) ? ultimoAltoQuebrado  : altoM3Reciente

distanciaCrudaBuy  = not na(nivelSLBuy)  ? close - nivelSLBuy  : na
distanciaCrudaSell = not na(nivelSLSell) ? nivelSLSell - close : na

distanciaFinalBuy  = not na(distanciaCrudaBuy)  ? (distanciaCrudaBuy  / close * 100 > UMBRAL_SL_PCT ? distanciaCrudaBuy  * REDUCCION_SL : distanciaCrudaBuy)  : na
distanciaFinalSell = not na(distanciaCrudaSell) ? (distanciaCrudaSell / close * 100 > UMBRAL_SL_PCT ? distanciaCrudaSell * REDUCCION_SL : distanciaCrudaSell) : na

slBuy  = not na(distanciaFinalBuy)  ? close - distanciaFinalBuy         : na
tpBuy  = not na(distanciaFinalBuy)  ? close + distanciaFinalBuy * RR_TP : na
slSell = not na(distanciaFinalSell) ? close + distanciaFinalSell         : na
tpSell = not na(distanciaFinalSell) ? close - distanciaFinalSell * RR_TP : na

// ============================================================================
// SECCIÓN 6C — LÍMITE DE OPERATIVA DIARIA (un trade a la vez, máx. 2 señales
// por sesión, Hedge Position) -- Fase 3 parte 2 (adelanta piezas de las
// Fases 4/5)
// ============================================================================
// Regla de Fabián, resumida en su propio "hack": UN SOLO TRADE ABIERTO A LA
// VEZ, nunca dos operaciones en simultáneo/paralelo. Por sesión (Pre-NY, NY
// y Asia cada una con su propio contador, no comparten límite entre sí) hay
// como máximo 2 señales, y la sesión queda cerrada (no se genera ninguna
// señal más, aunque aparezca un setup válido) apenas se da alguno de estos 3
// escenarios:
//   a) la 1ª señal llega a su TP
//   b) la 1ª señal llega a su SL y la 2ª (última) llega a su TP
//   c) la 1ª señal llega a su SL y la 2ª (última) también llega a su SL
//
// Mientras un trade sigue abierto (no llegó ni a SL ni a TP), puede
// dispararse una 2ª señal en sentido CONTRARIO -- Hedge Position -- pero en
// ese mismo instante el primer trade se da por cerrado (para sostener la
// regla de "un solo trade a la vez": nunca hay dos posiciones abiertas
// juntas, la 2ª reemplaza a la 1ª). Una 2ª señal en el MISMO sentido que la
// primera solo puede aparecer si la primera YA llegó a su SL (no antes --
// mientras sigue abierta en la misma dirección, no hay nada que invalide la
// señal original para dejar entrar una repetida).
grpLimite = "Límite de operativa diaria"
mostrarEstadoOperativo = input.bool(true, "Mostrar estado de la sesión (señales usadas / trade abierto) en el panel", group=grpLimite)

// inicio de cada sesión (flanco ascendente) -- acá se resetea el contador de
// señales y el estado del trade abierto, cada sesión arranca de cero y no
// comparte límite con las otras dos
inicioPreNY = enPreNY and not enPreNY[1]
inicioNY    = enNY and not enNY[1]
inicioAsia  = enAsia and not enAsia[1]
inicioSesion = inicioPreNY or inicioNY or inicioAsia

var int senalesSesion = 0
var bool sesionCerrada = false
var string tradeAbiertoDir = na  // "BUY" | "SELL" | na (sin trade abierto)
var float tradeAbiertoSL = na
var float tradeAbiertoTP = na
var bool tradeAbiertoEsHedge = false  // el trade abierto ahora mismo, ¿fue él mismo abierto por Hedge Position? (ver 3ª señal más abajo)

if inicioSesion
    senalesSesion := 0
    sesionCerrada := false
    tradeAbiertoDir := na
    tradeAbiertoSL := na
    tradeAbiertoTP := na
    tradeAbiertoEsHedge := false

// mientras haya un trade abierto, cada vela chequea si tocó su SL o su TP --
// igual que lo haría una orden real en MT5, sin esperar a que cierre la
// vela (a diferencia del cartel de señal, que sí espera barstate.isconfirmed)
if not na(tradeAbiertoDir)
    alcanzoTP = tradeAbiertoDir == "BUY" ? high >= tradeAbiertoTP : low <= tradeAbiertoTP
    alcanzoSL = tradeAbiertoDir == "BUY" ? low <= tradeAbiertoSL  : high >= tradeAbiertoSL
    if alcanzoTP
        // escenario a) o b): cualquier TP (1ª, 2ª o 3ª señal) cierra la sesión
        sesionCerrada := true
        tradeAbiertoDir := na
        tradeAbiertoEsHedge := false
    else if alcanzoSL
        tradeAbiertoDir := na
        tradeAbiertoEsHedge := false
        // escenario c): si el que acaba de llegar al SL ya era la 2ª señal (o la 3ª, caso Hedge encadenado), cierra la sesión
        if senalesSesion >= 2
            sesionCerrada := true
        // si era la 1ª, la sesión sigue abierta -- habilita la 2ª y última señal

// puede dispararse una señal nueva en esta dirección si: la sesión no está
// cerrada, y (no se agotaron las 2 señales normales, y no hay trade abierto
// o el trade abierto es en el sentido CONTRARIO -- Hedge, que cierra al
// primero) o (caso aislado: 3ª y ÚLTIMA señal, ver tercerHedgeBuy/Sell)
//
// tercerHedgeBuy/Sell (14/09, caso aislado confirmado por Fabián): si las
// dos señales ya usadas en la sesión fueron DOS HEDGES SEGUIDOS (la 2ª
// cerró a la 1ª por Hedge, y ahora aparece una 3ª en sentido contrario
// mientras la 2ª sigue abierta, sin haber llegado ni a SL ni a TP), se
// habilita esta 3ª y última señal -- pero solo si para ese momento la
// sesión todavía no llegó a ninguno de los 3 escenarios de cierre
// (sesionCerrada sigue en false). Nunca hay una 4ª: la excepción exige
// senalesSesion == 2 exacto (no <=2), así que después de esta 3ª señal
// (senalesSesion pasa a 3) ninguna de las dos condiciones vuelve a dar true.
tercerHedgeBuy  = senalesSesion == 2 and not na(tradeAbiertoDir) and tradeAbiertoDir == "SELL" and tradeAbiertoEsHedge
tercerHedgeSell = senalesSesion == 2 and not na(tradeAbiertoDir) and tradeAbiertoDir == "BUY"  and tradeAbiertoEsHedge

puedeGenerarBuy  = not sesionCerrada and ((senalesSesion < 2 and (na(tradeAbiertoDir) or tradeAbiertoDir == "SELL")) or tercerHedgeBuy)
puedeGenerarSell = not sesionCerrada and ((senalesSesion < 2 and (na(tradeAbiertoDir) or tradeAbiertoDir == "BUY"))  or tercerHedgeSell)

// señal final: la que ya tenía el MEC (mecBuySenal/mecSellSenal), filtrada
// por el límite de operativa diaria -- esto YA resuelve, de paso, "una señal
// por vela hasta invalidarse": mientras el trade sigue abierto en el mismo
// sentido, puedeGenerarX da false y no puede repetirse.
// not na(...) explícito antes del == -- mismo motivo que en Sección 2: no
// confiar en cómo Pine resuelve una comparación contra un string en na.
esHedgeBuy  = mecBuySenal  and puedeGenerarBuy  and not na(tradeAbiertoDir) and tradeAbiertoDir == "SELL"
esHedgeSell = mecSellSenal and puedeGenerarSell and not na(tradeAbiertoDir) and tradeAbiertoDir == "BUY"
mecBuySenalFinal  = mecBuySenal  and puedeGenerarBuy
mecSellSenalFinal = mecSellSenal and puedeGenerarSell

// ============================================================================
// SECCIÓN 6D — ALERTAS DE TRADINGVIEW (Fase 3 parte 2)
// ============================================================================
// alert() (no alertcondition()): alertcondition() solo admite mensajes
// estáticos (sin poder meter el precio de entrada/SL/TP REAL calculado en
// esa señal puntual); alert() sí arma el mensaje con los valores de la vela
// actual, que es lo que hace falta acá. Para recibirlas: crear UNA alerta
// sobre este indicador con condición "Any alert() function call" -- dispara
// tanto para BUY como para SELL, cada una con su propio texto.
// alert.freq_once_per_bar_close: refuerza lo que ya hace barstate.isconfirmed
// más abajo (nunca dispara en un tick intermedio, solo al cerrar la vela).
grpAlertas = "Alertas"
activarAlertas = input.bool(true, "Activar alertas de TradingView (alert()) en cada señal BUY/SELL", group=grpAlertas)

// nombre de la sesión vigente, para el texto de la alerta -- mismas
// variables de la Sección 1, sin agregar nada nuevo
sesionActualTxt = enPreNY ? "Pre-NY" : enNY ? "NY" : enAsia ? "Asia" : "fuera de sesión"

// ---------------------------- CARTEL DE SEÑAL (nube gris claro, solo BUY/SELL) ----------------------------
// Nube minimalista: fondo gris claro, texto blanco en mayúsculas. BUY debajo
// de la vela de entrada (apunta hacia arriba), SELL arriba (apunta hacia
// abajo). Sin ficha de datos -- eso era contexto para mí, no parte del
// diseño final del cartel.
//
// barstate.isconfirmed: el cartel SOLO se dibuja en la ejecución final y
// confirmada de la vela M1 (cuando ya cerró), nunca en un tick intermedio
// mientras la vela todavía se está formando. Sin este freno, TradingView
// recalcula el script en cada tick de la vela en curso -- si en algún tick
// intermedio la vela luce momentáneamente como una envolvente/Start válida
// y el precio se revierte antes de que cierre el minuto, quedaría una
// etiqueta fantasma dibujada que Pine no borra solo. El patrón envolvente/
// Start se define con el open/close/high/low FINAL de la vela, así que no
// existe forma honesta de confirmarlo antes de que esa vela cierre.
colorCartel = color.new(color.silver, 0)

// mecBuySenal/mecSellSenal -> mecBuySenalFinal/mecSellSenalFinal (Sección
// 6C): ya filtradas por el límite de operativa diaria (1 trade a la vez,
// máx. 2/3 señales por sesión). El texto suma "(HEDGE)" cuando esta señal
// cierra un trade contrario que seguía abierto.
//
// 14/09 -- separado en tres partes independientes, ya NO todo bajo
// `mostrarSenalMEC`: antes, apagar el cartel visual (`mostrarSenalMEC =
// false`) también apagaba la actualización del estado de la sesión
// (senalesSesion/tradeAbiertoDir de la Sección 6C) -- un bug latente, nunca
// reportado porque Fabián siempre lo deja activado, pero real: la señal en
// SÍ (mecBuySenalFinal/mecSellSenalFinal) es la que manda, el cartel y la
// alerta son solo dos formas de EXPONERLA. Ahora el estado de la sesión se
// actualiza siempre que la señal es real, el cartel se dibuja solo si
// `mostrarSenalMEC`, y la alerta se dispara solo si `activarAlertas` --
// cada uno con su propio interruptor, sin que uno dependa del otro.
if mecBuySenalFinal and barstate.isconfirmed
    if mostrarSenalMEC
        // 14/09: el cartel vuelve a decir SIEMPRE "BUY" a secas, sea o no
        // Hedge -- Fabián lo pidió simple y minimalista, como el diseño
        // original. El tag "(HEDGE)" queda solo en el texto de la alerta
        // (más abajo), que es informativo, no parte del cartel visual.
        label.new(bar_index, low, "BUY", style=label.style_label_up, color=colorCartel, textcolor=color.white, size=size.normal)
        if mostrarSLTP and not na(slBuy)
            label.new(bar_index, slBuy, "SL " + str.tostring(slBuy, "#.###"), style=label.style_label_left, color=color.new(color.red, 20), textcolor=color.white, size=size.tiny)
            label.new(bar_index, tpBuy, "TP " + str.tostring(tpBuy, "#.###"), style=label.style_label_left, color=color.new(color.teal, 20), textcolor=color.white, size=size.tiny)
    if activarAlertas
        mensajeBuy = "XAUUSD Scalper -- BUY" + (esHedgeBuy ? " (HEDGE)" : "") + " | Sesión: " + sesionActualTxt + " | Entrada: " + str.tostring(close, "#.###") + (not na(slBuy) ? " | SL: " + str.tostring(slBuy, "#.###") + " | TP: " + str.tostring(tpBuy, "#.###") : " | SL/TP no disponible")
        alert(mensajeBuy, alert.freq_once_per_bar_close)
    senalesSesion := senalesSesion + 1
    tradeAbiertoDir := "BUY"
    tradeAbiertoSL := slBuy
    tradeAbiertoTP := tpBuy
    tradeAbiertoEsHedge := esHedgeBuy

if mecSellSenalFinal and barstate.isconfirmed
    if mostrarSenalMEC
        // ver comentario en el bloque BUY de arriba
        label.new(bar_index, high, "SELL", style=label.style_label_down, color=colorCartel, textcolor=color.white, size=size.normal)
        if mostrarSLTP and not na(slSell)
            label.new(bar_index, slSell, "SL " + str.tostring(slSell, "#.###"), style=label.style_label_left, color=color.new(color.red, 20), textcolor=color.white, size=size.tiny)
            label.new(bar_index, tpSell, "TP " + str.tostring(tpSell, "#.###"), style=label.style_label_left, color=color.new(color.teal, 20), textcolor=color.white, size=size.tiny)
    if activarAlertas
        mensajeSell = "XAUUSD Scalper -- SELL" + (esHedgeSell ? " (HEDGE)" : "") + " | Sesión: " + sesionActualTxt + " | Entrada: " + str.tostring(close, "#.###") + (not na(slSell) ? " | SL: " + str.tostring(slSell, "#.###") + " | TP: " + str.tostring(tpSell, "#.###") : " | SL/TP no disponible")
        alert(mensajeSell, alert.freq_once_per_bar_close)
    senalesSesion := senalesSesion + 1
    tradeAbiertoDir := "SELL"
    tradeAbiertoSL := slSell
    tradeAbiertoTP := tpSell
    tradeAbiertoEsHedge := esHedgeSell

// ============================================================================
// SECCIÓN 7 — PANEL DE ESTADO
// ============================================================================
var table panel = table.new(position.top_right, 1, 3, border_width=1)
if barstate.islast
    table.cell(panel, 0, 0, tendencia == "alcista" ? "Uptrend (BUY)" : tendencia == "bajista" ? "Downtrend (SELL)" : "Undefined", text_color=color.white, bgcolor=tendencia == "alcista" ? color.new(color.green, 40) : tendencia == "bajista" ? color.new(color.red, 40) : color.new(color.gray, 40))
    table.cell(panel, 0, 1, mecListo ? "MEC ready" : esperandoContinuacion ? "Waiting for MEC" : "No Entry", text_color=color.white, bgcolor=mecListo ? color.new(color.teal, 40) : esperandoContinuacion ? color.new(color.orange, 40) : color.new(color.gray, 70))
    // Sección 6C: estado de la operativa diaria de la sesión (se resetea al
    // arrancar cada sesión) -- señales usadas (tope normal: 2; 3 solo en el
    // caso aislado de dos Hedge seguidos, ver tercerHedgeBuy/Sell) y si hay
    // un trade abierto ahora mismo (en qué dirección, y si es un Hedge).
    if mostrarEstadoOperativo
        senalesTxt = str.tostring(senalesSesion) + " señal" + (senalesSesion == 1 ? "" : "es")
        tradeTxt = not na(tradeAbiertoDir) ? tradeAbiertoDir + (tradeAbiertoEsHedge ? " (Hedge)" : "") + " abierto" : "sin trade abierto"
        textoEstadoOperativo = (sesionCerrada ? "Sesión CERRADA -- " : "") + senalesTxt + ", " + tradeTxt
        table.cell(panel, 0, 2, textoEstadoOperativo, text_color=color.white, bgcolor=sesionCerrada ? color.new(color.gray, 40) : not na(tradeAbiertoDir) ? color.new(color.blue, 40) : color.new(color.gray, 70))
