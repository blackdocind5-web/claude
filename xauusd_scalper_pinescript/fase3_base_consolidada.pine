//@version=5
indicator("XAUUSD Scalper — Base Consolidada (Fases 1+2)", overlay=true, max_lines_count=500, max_labels_count=500)

// ============================================================================
// BASE CONSOLIDADA — une Fase 1 (estructura M3 + sesiones) y Fase 2
// (envolvente + patrón Start) en un solo script. Es el punto de partida de
// la Fase 3 (MEC + SL/TP + señal final), que necesita ambas piezas
// funcionando juntas -- Pine Script no puede hacer que un indicador lea
// datos de otro.
//
// NINGUNA lógica validada se modificó al consolidar -- solo se renombraron
// algunas variables que se repetían entre los 3 archivos originales y se
// evitó recalcular dos veces la clasificación de envolvente (Fase 2b la
// reutiliza de Fase 2a en vez de duplicarla).
//
// Las etiquetas/triángulos de debug de las Fases 2a/2b (envolvente y patrón
// Start sueltos) ya se retiraron del dibujo -- cumplieron su función para
// validar el volumen de cada vela letra por letra contra los gráficos
// reales, pero el cálculo se mantiene intacto porque el motor MEC lo sigue
// necesitando. Estética final: solo el cartel de señal MEC BUY/SELL.
//
// A partir de acá reemplaza a fase1_estructura_m3.pine,
// fase2a_patron_envolvente.pine y fase2b_patron_start.pine -- cargar solo
// este archivo.
// ============================================================================

// ============================================================================
// SECCIÓN 1 — SESIONES OPERATIVAS (Fase 1)
// ============================================================================
grpSesiones = "Sesiones operativas"
mostrarSesiones = input.bool(true, "Sombrear sesiones en el gráfico", group=grpSesiones)
colorPreNY = input.color(color.new(#d3d3d3, 85), "Color sesión Pre-NY (07-09 EST)", group=grpSesiones)
colorAsia  = input.color(color.new(#d3d3d3, 85), "Color sesión Asia (20-22 EST)", group=grpSesiones)

// Días Pine: 1=Domingo 2=Lunes 3=Martes 4=Miércoles 5=Jueves 6=Viernes 7=Sábado
// Pre-NY: Lunes a Viernes (2=Lunes ... 6=Viernes) | Asia: Domingo a Jueves (1=Domingo ... 5=Jueves)
sesionPreNYStr = "0700-0900:23456"
sesionAsiaStr  = "2000-2200:12345"

enPreNY = not na(time(timeframe.period, sesionPreNYStr, "America/New_York"))
enAsia  = not na(time(timeframe.period, sesionAsiaStr, "America/New_York"))
enSesionOperativa = enPreNY or enAsia  // <- se reutiliza para filtrar la señal final en Fase 3

bgcolor(mostrarSesiones and enPreNY ? colorPreNY : na, title="Sesión Pre-NY")
bgcolor(mostrarSesiones and enAsia  ? colorAsia  : na, title="Sesión Asia")

// ============================================================================
// SECCIÓN 2 — ESTRUCTURA DE MERCADO M3 (Fase 1)
// ============================================================================
grpEstructura = "Estructura M3"
colorPunteada    = input.color(color.new(#787b86, 0), "Línea punteada (continuación)", group=grpEstructura)
colorContinua    = input.color(color.new(color.black, 0), "Línea continua (cambio de estructura)", group=grpEstructura)
extensionBarras  = input.int(10, "Extensión sin toque (barras M1)", minval=1, group=grpEstructura)
limitarLineasASesion = input.bool(true, "Dibujar líneas M3 solo durante Pre-NY/Asia (más historial dentro del cupo de 500 líneas)", group=grpEstructura)
mostrarDebugM3 = input.bool(false, "DEBUG temporal: etiqueta con el valor exacto de cada Alto/Bajo M3 reconocido", group=grpEstructura)

[o3, h3, l3, c3, t3] = request.security(syminfo.tickerid, "3", [open, high, low, close, time], lookahead=barmerge.lookahead_off)
nuevaVelaM3 = ta.change(t3) != 0

// var ultimoT0Procesado (10/09): con el debug de valores exactos se detectó
// que un mismo pivote (ej. Alto M3 de 07:03) podía quedar reconocido DOS
// veces -- ta.change(t3) disparándose más de una vez para la misma vela M3
// ya cerrada. Sin este freno, un reconocimiento duplicado vuelve a correr
// todo el motor de tramos sobre la MISMA vela, lo que puede hacerlo procesar
// el estado en un orden distinto al real y retroceder a un pivote viejo.
// Guardar el t0 (apertura de la vela M3, t3[1]) de la última vela realmente
// procesada evita reprocesar la misma vela más de una vez, sin cambiar en
// nada el resultado de una secuencia normal (donde cada vela ya se procesa
// una sola vez).
var int ultimoT0Procesado = na
// OJO: comparar contra na con != no funciona como se espera en Pine (na
// "envenena" la comparación y da false en vez de true) -- por eso el chequeo
// de abajo usa na(ultimoT0Procesado) explícito para la primerísima vela, en
// vez de confiar en que t3[1] != na dé true.

var string curDir = na
var float curHigh = na
var int   curHighT = na
var float curLow = na
var int   curLowT = na

var string prevDir = na
var float prevHigh = na
var int   prevHighT = na
var float prevLow = na
var int   prevLowT = na

esAltoM3 = false
esBajoM3 = false
nivelAlto = float(na)
nivelBajo = float(na)
altoRunInicio = int(na)
bajoRunInicio = int(na)

if nuevaVelaM3 and (na(ultimoT0Procesado) or t3[1] != ultimoT0Procesado)
    o0 = o3[1]
    h0 = h3[1]
    l0 = l3[1]
    c0 = c3[1]
    t0 = t3[1]
    ultimoT0Procesado := t0
    candleDir = c0 > o0 ? "alcista" : c0 < o0 ? "bajista" : "doji"

    if na(curDir)
        if candleDir != "doji"
            curDir := candleDir
            curHigh := h0, curHighT := t0
            curLow := l0, curLowT := t0
    else if candleDir == curDir or candleDir == "doji"
        if h0 > curHigh
            curHigh := h0, curHighT := t0
        if l0 < curLow
            curLow := l0, curLowT := t0
    else
        prevDir := curDir, prevHigh := curHigh, prevHighT := curHighT, prevLow := curLow, prevLowT := curLowT
        curDir := candleDir
        curHigh := h0, curHighT := t0
        curLow := l0, curLowT := t0

    if not na(prevDir) and prevDir != curDir
        if prevDir == "alcista" and curDir == "bajista"
            esAltoM3 := true
            nivelAlto := math.max(prevHigh, curHigh)
            altoRunInicio := prevHighT
        if prevDir == "bajista" and curDir == "alcista"
            esBajoM3 := true
            nivelBajo := math.min(prevLow, curLow)
            bajoRunInicio := prevLowT

var line altoLinea = na
var line bajoLinea = na
var float altoM3Activo = na
var float bajoM3Activo = na
var int altoM3Inicio = na
var int bajoM3Inicio = na
var bool altoRoto = false
var bool bajoRoto = false
var bool altoLineaActiva = false  // hay una línea DIBUJADA para el altoM3Activo vigente -- nace/muere con la sesión operativa, el NIVEL en sí (altoM3Activo) sigue existiendo igual
var bool bajoLineaActiva = false
var string tendencia = "indefinida"  // "alcista" | "bajista" | "indefinida"

maxExtMs = extensionBarras * timeframe.in_seconds("1") * 1000

// dibujarLineasM3: el motor interno (altoM3Activo/bajoM3Activo, quiebreAlto/
// quiebreBajo, tendencia, todo lo que el MEC necesita) sigue corriendo las
// 24hs -- acá solo se apaga el DIBUJO de las líneas, que es lo que consume
// el cupo compartido de 500 líneas de TradingView. Pre-NY + Asia ocupan
// ~17% del día, así que esto multiplica por ~6 el historial visible de
// líneas antes de que empiecen a borrarse las más viejas. El interruptor
// (limitarLineasASesion) queda disponible por si hace falta ver la
// estructura completa fuera de esas horas para depurar un caso puntual.
dibujarLineasM3 = not limitarLineasASesion or enSesionOperativa

if esAltoM3
    if not na(altoM3Inicio) and altoM3Inicio == altoRunInicio
        altoM3Activo := nivelAlto
        if altoLineaActiva
            line.set_y1(altoLinea, nivelAlto)
            line.set_y2(altoLinea, nivelAlto)
    else
        if altoLineaActiva and not altoRoto
            line.set_x2(altoLinea, int(math.min(time, altoM3Inicio + maxExtMs)))
        altoM3Activo := nivelAlto
        altoM3Inicio := altoRunInicio
        altoRoto := false
        altoLineaActiva := dibujarLineasM3
        if altoLineaActiva
            altoLinea := line.new(x1=altoRunInicio, y1=nivelAlto, x2=time, y2=nivelAlto, xloc=xloc.bar_time, color=colorPunteada, style=line.style_dotted, width=1)

if esBajoM3
    if not na(bajoM3Inicio) and bajoM3Inicio == bajoRunInicio
        bajoM3Activo := nivelBajo
        if bajoLineaActiva
            line.set_y1(bajoLinea, nivelBajo)
            line.set_y2(bajoLinea, nivelBajo)
    else
        if bajoLineaActiva and not bajoRoto
            line.set_x2(bajoLinea, int(math.min(time, bajoM3Inicio + maxExtMs)))
        bajoM3Activo := nivelBajo
        bajoM3Inicio := bajoRunInicio
        bajoRoto := false
        bajoLineaActiva := dibujarLineasM3
        if bajoLineaActiva
            bajoLinea := line.new(x1=bajoRunInicio, y1=nivelBajo, x2=time, y2=nivelBajo, xloc=xloc.bar_time, color=colorPunteada, style=line.style_dotted, width=1)

// DEBUG TEMPORAL (10/09): etiqueta con el valor y el ancla exactos de CADA
// Alto/Bajo M3 que el motor reconoce, para comparar contra los valores
// esperados a mano cuando hay una duda como la del CHoCH de las 07:25.
// Sacar esta sección una vez resuelto el caso.
if mostrarDebugM3 and esAltoM3
    label.new(bar_index, high, "A:" + str.tostring(nivelAlto, "#.###") + " @" + str.format_time(altoRunInicio, "HH:mm", "America/New_York"), style=label.style_label_down, color=color.new(color.blue, 0), textcolor=color.white, size=size.tiny)
if mostrarDebugM3 and esBajoM3
    label.new(bar_index, low, "B:" + str.tostring(nivelBajo, "#.###") + " @" + str.format_time(bajoRunInicio, "HH:mm", "America/New_York"), style=label.style_label_up, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny)

// si el nivel ya estaba activo desde antes de entrar en sesión (o justo se
// prendió el interruptor), recién ahora lo dibuja -- arranca la línea en su
// x1 real (altoM3Inicio/bajoM3Inicio), no en la barra actual
if dibujarLineasM3 and not altoLineaActiva and not na(altoM3Activo)
    altoLineaActiva := true
    altoLinea := line.new(x1=altoM3Inicio, y1=altoM3Activo, x2=time, y2=altoM3Activo, xloc=xloc.bar_time, color=colorPunteada, style=line.style_dotted, width=1)
if dibujarLineasM3 and not bajoLineaActiva and not na(bajoM3Activo)
    bajoLineaActiva := true
    bajoLinea := line.new(x1=bajoM3Inicio, y1=bajoM3Activo, x2=time, y2=bajoM3Activo, xloc=xloc.bar_time, color=colorPunteada, style=line.style_dotted, width=1)

if altoLineaActiva and not na(altoM3Activo)
    line.set_x2(altoLinea, int(math.min(time, altoM3Inicio + maxExtMs)))
if bajoLineaActiva and not na(bajoM3Activo)
    line.set_x2(bajoLinea, int(math.min(time, bajoM3Inicio + maxExtMs)))

quiebreAlto = not na(altoM3Activo) and ta.crossover(close, altoM3Activo)
quiebreBajo = not na(bajoM3Activo) and ta.crossunder(close, bajoM3Activo)

// se reutiliza en Fase 3 para saber si el último quiebre fue continuación (BOS) o cambio de estructura (CHoCH)
var bool ultimoQuiebreFueCambioEstructura = false

// alcance global (no local a los bloques de abajo) porque la Sección 6 (MEC) también los necesita
esCambioEstructuraAlto = false
esCambioEstructuraBajo = false
nivelQuebradoAlto = float(na)
nivelQuebradoBajo = float(na)

if quiebreAlto
    nivelQuebradoAlto := altoM3Activo
    esCambioEstructuraAlto := tendencia == "bajista"
    if altoLineaActiva
        line.set_x2(altoLinea, time)
        line.set_style(altoLinea, esCambioEstructuraAlto ? line.style_solid : line.style_dotted)
        line.set_color(altoLinea, esCambioEstructuraAlto ? colorContinua : colorPunteada)
        line.set_width(altoLinea, esCambioEstructuraAlto ? 2 : 1)
    tendencia := "alcista"
    altoM3Activo := na
    altoRoto := true
    altoLineaActiva := false
    ultimoQuiebreFueCambioEstructura := esCambioEstructuraAlto

if quiebreBajo
    nivelQuebradoBajo := bajoM3Activo
    esCambioEstructuraBajo := tendencia == "alcista"
    if bajoLineaActiva
        line.set_x2(bajoLinea, time)
        line.set_style(bajoLinea, esCambioEstructuraBajo ? line.style_solid : line.style_dotted)
        line.set_color(bajoLinea, esCambioEstructuraBajo ? colorContinua : colorPunteada)
        line.set_width(bajoLinea, esCambioEstructuraBajo ? 2 : 1)
    tendencia := "bajista"
    bajoM3Activo := na
    bajoRoto := true
    bajoLineaActiva := false
    ultimoQuiebreFueCambioEstructura := esCambioEstructuraBajo

// ============================================================================
// SECCIÓN 3 — CLASIFICADOR DE VELA ENVOLVENTE EN M1 (Fase 2a)
// ============================================================================
// Sin controles visuales propios -- esto fue el clasificador de la Fase 2a,
// útil en su momento para validar letra por letra el volumen de cada vela
// contra los gráficos reales de Fabián. Ya validado, el motor MEC (Sección 6)
// es el único que consume estas variables; no se dibuja nada de esta sección.
//
// TOLERANCIA_CUERPO: margen sobre los cortes de 85%/90% del cuerpo. Fabián
// mide el volumen a ojo con una grilla de Gann dibujada a mano (sin
// decimales) -- exigirle al código una precisión matemática perfecta sobre
// un corte que él mismo definió visualmente es MÁS estricto que el propio
// método que estamos formalizando. No cambia qué es una envolvente (sigue
// exigiendo cuerpo dominante), solo reconoce que ese método de referencia
// no resuelve más allá de este margen. Caso real que lo motivó: vela de
// 30/08 20:35, cuerpo 84,60% -- Fabián la confirmó como Estándar válida.
//
// Martillo exige un cuerpo CHICO (tal como lo indica su nombre): el nivel
// del lado de la apertura tiene que caer en la banda angosta 40%-50% (no
// en cualquier punto >=50%, como era antes) -- confirmado por Fabián el
// 09/09.
//
// Doji: las dos ramas estaban INVERTIDAS desde la Fase 2a -- corregido el
// 09/09. nivelOpen >= 15% (el open queda más lejos del extremo) exige el
// cierre más estricto (90%); nivelOpen < 15% (open ya casi en el extremo)
// se conforma con 85%. Caso real que lo destapó: SELL 31/08 08:25,
// nivelOpen 24,80% (>=15%) exigía cierre >=90%, cerró en 86,64% -- inválida.
// Un nivelOpen por ENCIMA de la banda de Martillo (>50%+TOL) ya NO se
// evalúa como Doji -- ver el techo agregado el 10/09 más abajo.
grpEnvolvente = "Patrón envolvente / Start"
TOLERANCIA_CUERPO = input.float(0.01, "Margen sobre 85%/90% de cuerpo (grilla de Gann a mano)", minval=0, maxval=0.05, step=0.005, group=grpEnvolvente)

rango = high - low
esAlcista = close > open
esBajista = close < open

// -- BUY: 0 = low, 1 = high --
nivelOpenBuy  = rango > 0 ? (open - low) / rango : na
nivelCloseBuy = rango > 0 ? (close - low) / rango : na
cuerpoPctBuy  = nivelCloseBuy - nivelOpenBuy

esEstandarBuy = esAlcista and cuerpoPctBuy >= 0.85 - TOLERANCIA_CUERPO
// Martillo exige un cuerpo CHICO (tal como lo indica su nombre): el extremo
// del cuerpo del lado de la apertura tiene que caer en la banda angosta
// 40%-50%.
esMartilloBuy = esAlcista and not esEstandarBuy and nivelOpenBuy >= 0.40 - TOLERANCIA_CUERPO and nivelOpenBuy <= 0.50 + TOLERANCIA_CUERPO and nivelCloseBuy >= 0.85 - TOLERANCIA_CUERPO
// nivelOpen >= 15% (el open queda más lejos del extremo) exige el cierre
// más estricto (90%); nivelOpen < 15% (open ya casi en el extremo) se
// conforma con 85% -- corregido el 09/09, estaba invertido desde la Fase 2a.
// Techo en 40%-TOL (10/09): un nivelOpen por ENCIMA de la banda de Martillo
// ya NO se evalúa como Doji -- significa que más de la mitad del rango es
// mecha en contra antes de la apertura, la misma forma que la Sección 4
// reconoce como vela de indecisión/pinbar, no una vela envolvente decisiva
// por más lejos que llegue el cierre. Caso real que lo destapó: SELL 10/09
// 08:30, nivelOpen 64,96% y cierre 91,62% (pasaba la regla vieja del 90%)
// con un cuerpo real de apenas 26,66% -- Fabián la identificó a mano como
// pinbar bajista, vela de indecisión del patrón Start confirmado recién en
// la vela siguiente (08:31).
esDojiBuy     = esAlcista and not esEstandarBuy and not esMartilloBuy and nivelOpenBuy < 0.40 - TOLERANCIA_CUERPO and ((nivelOpenBuy >= 0.15 and nivelCloseBuy >= 0.90 - TOLERANCIA_CUERPO) or (nivelOpenBuy < 0.15 and nivelCloseBuy >= 0.85 - TOLERANCIA_CUERPO))
esEnvolventeBuy = esEstandarBuy or esMartilloBuy or esDojiBuy

// -- SELL: 0 = high, 1 = low --
nivelOpenSell  = rango > 0 ? (high - open) / rango : na
nivelCloseSell = rango > 0 ? (high - close) / rango : na
cuerpoPctSell  = nivelCloseSell - nivelOpenSell

esEstandarSell = esBajista and cuerpoPctSell >= 0.85 - TOLERANCIA_CUERPO
esMartilloSell = esBajista and not esEstandarSell and nivelOpenSell >= 0.40 - TOLERANCIA_CUERPO and nivelOpenSell <= 0.50 + TOLERANCIA_CUERPO and nivelCloseSell >= 0.85 - TOLERANCIA_CUERPO
esDojiSell     = esBajista and not esEstandarSell and not esMartilloSell and nivelOpenSell < 0.40 - TOLERANCIA_CUERPO and ((nivelOpenSell >= 0.15 and nivelCloseSell >= 0.90 - TOLERANCIA_CUERPO) or (nivelOpenSell < 0.15 and nivelCloseSell >= 0.85 - TOLERANCIA_CUERPO))
esEnvolventeSell = esEstandarSell or esMartilloSell or esDojiSell

// pullback inmediato (1 vela contraria antes de la vela envolvente misma) -- distinto del pullback del patrón Start
pullbackEnvolventeBuy  = close[1] < open[1]
pullbackEnvolventeSell = close[1] > open[1]

candidataEnvolventeBuy  = esEnvolventeBuy  and pullbackEnvolventeBuy
candidataEnvolventeSell = esEnvolventeSell and pullbackEnvolventeSell

tipoEnvBuy  = esEstandarBuy  ? "Estándar" : esMartilloBuy  ? "Martillo" : esDojiBuy  ? "Doji" : na
tipoEnvSell = esEstandarSell ? "Estándar" : esMartilloSell ? "Martillo" : esDojiSell ? "Doji" : na

// ============================================================================
// SECCIÓN 4 — PATRÓN START: indecisión + envolvente de continuación (Fase 2b)
// ============================================================================
// Sin controles visuales propios, misma razón que la Sección 3.
rangoInd = high[1] - low[1]
TOLERANCIA = 0.0001  // 0,01%

// -- vela de indecisión (candle[1]) medida en marco D=BUY --
nivelOpenIndBuy  = rangoInd > 0 ? (open[1] - low[1]) / rangoInd : na
nivelCloseIndBuy = rangoInd > 0 ? (close[1] - low[1]) / rangoInd : na
cuerpoIndBuy = math.abs(nivelCloseIndBuy - nivelOpenIndBuy)
esMartilloIndBuy = nivelOpenIndBuy >= 0.40 - TOLERANCIA_CUERPO and nivelOpenIndBuy <= 0.50 + TOLERANCIA_CUERPO and nivelCloseIndBuy >= 0.85 - TOLERANCIA_CUERPO
esIndecisionBuy = cuerpoIndBuy <= 0.50 + TOLERANCIA and not esMartilloIndBuy

wickContraBuy = math.min(nivelOpenIndBuy, nivelCloseIndBuy)
wickFavorBuy  = 1 - math.max(nivelOpenIndBuy, nivelCloseIndBuy)
tipoIndBuy = esIndecisionBuy ? (math.abs(wickContraBuy - wickFavorBuy) <= 0.15 ? "Doji" : "Pinbar") : na

// -- vela de indecisión (candle[1]) medida en marco D=SELL --
nivelOpenIndSell  = rangoInd > 0 ? (high[1] - open[1]) / rangoInd : na
nivelCloseIndSell = rangoInd > 0 ? (high[1] - close[1]) / rangoInd : na
cuerpoIndSell = math.abs(nivelCloseIndSell - nivelOpenIndSell)
esMartilloIndSell = nivelOpenIndSell >= 0.40 - TOLERANCIA_CUERPO and nivelOpenIndSell <= 0.50 + TOLERANCIA_CUERPO and nivelCloseIndSell >= 0.85 - TOLERANCIA_CUERPO
esIndecisionSell = cuerpoIndSell <= 0.50 + TOLERANCIA and not esMartilloIndSell

wickContraSell = math.min(nivelOpenIndSell, nivelCloseIndSell)
wickFavorSell  = 1 - math.max(nivelOpenIndSell, nivelCloseIndSell)
tipoIndSell = esIndecisionSell ? (math.abs(wickContraSell - wickFavorSell) <= 0.15 ? "Doji" : "Pinbar") : na

// pullback del patrón Start: candle[2] contrario a D (distinto de pullbackEnvolventeBuy/Sell, que mira candle[1])
pullbackStartBuy  = close[2] < open[2]
pullbackStartSell = close[2] > open[2]

// invalidación: 3 velas consecutivas del mismo color
mismoColor3 = (close > open and close[1] > open[1] and close[2] > open[2]) or (close < open and close[1] < open[1] and close[2] < open[2])

esStartBuy  = esEnvolventeBuy  and esIndecisionBuy  and pullbackStartBuy  and not mismoColor3
esStartSell = esEnvolventeSell and esIndecisionSell and pullbackStartSell and not mismoColor3

// ============================================================================
// SECCIÓN 6 — MODELO MEC (Fase 3)
// ============================================================================
// mecListo = true  -> ya hubo al menos una Continuación confirmada desde el
//   último reset (la estructura está habilitada para buscar entradas a favor
//   de la `tendencia` vigente).
//
// Regla general ("todos los niveles a la izquierda", confirmada por
// Fabián): para que UNA ENTRADA PUNTUAL sea válida no alcanza con que
// `mecListo` esté en true -- esa vela concreta (envolvente o Start) tiene
// que superar, ella misma, el nivel más reciente con el umbral configurado
// (`UMBRAL_QUIEBRE`, default 0,005%) de volumen. Por
// eso `extremoQuiebre` es un nivel que se extiende con la mecha de TODA
// vela M1 (a favor o en contra, la haya superado o no) SIEMPRE, corra o no
// una búsqueda activa -- así el nivel sigue creciendo con la tendencia
// aunque `mecListo` ya esté en true.
//
// Reset COMPLETO (pierde `mecListo` y hay que rearmar `huboPullbackEnBusqueda`
// desde cero) SOLO ante un CHoCH real -- cuando `esCambioEstructuraAlto` o
// `esCambioEstructuraBajo` es true, es decir la tendencia efectivamente
// cambia. Un BOS (mismo quiebre, pero la tendencia sigue igual) o la
// formación de un Alto/Bajo M3 nuevo EN LA MISMA dirección NO resetean nada
// -- el nivel ya se extiende solo, vela a vela, con el bloque de abajo.
// Corregido el 09/09: antes cualquier BOS (no solo el CHoCH) reseteaba todo,
// lo cual en una tendencia sana con varios BOS seguidos (normal, sin cambio
// real de estructura) tiraba abajo `mecListo` una y otra vez, dejando el
// motor "esperando Continuación" casi toda la sesión en vez de sostenerse
// listo. Caso real que lo destapó: BUY 03/09 20:55, pullback largo y mixto
// con varios BOS internos sin cambio de tendencia real.
// (El primerísimo quiebre de la sesión, viniendo de tendencia "indefinida",
// también inicializa el nivel aunque no sea técnicamente un CHoCH.)
//
// Confirmación de Continuación: una vez que hubo al menos 1 vela de
// pullback desde el reset, la primera vela a favor que cierra superando
// `extremoQuiebre` con el umbral configurado marca `mecListo := true`.
//
// Validación de CADA entrada: en TODAS las velas (haya o no búsqueda de
// pullback en curso) se recalcula si esta vela puntual superó el nivel
// vigente (`superaNivelAhora`) ANTES de que su propia mecha lo actualice.
// La señal final exige `mecListo` (ya hubo una Continuación válida en este
// tramo) Y `superaNivelAhora` en ESA vela puntual -- una reentrada
// posterior no hereda gratis la validación original.
//
// UMBRAL_QUIEBRE: default 0,005% (mitad del 0,01% original), no 0,01%
// literal. Fabián mide este volumen con la herramienta "rango de precios"
// de TradingView, que redondea a 2 decimales -- un volumen real de
// 0,00742% ya le aparece como "0,01%" en pantalla, indistinguible de un
// 0,01000% exacto. Bajar el umbral a la mitad cubre todo lo que esa
// herramienta redondearía hacia "0,01%". Caso real que lo motivó: BUY
// 02/09 07:12, volumen real 0,00742% (nivel 4.315,905 -> cierre 4.316,225).
grpMEC = "Modelo MEC"
mostrarSenalMEC = input.bool(true, "Mostrar cartel de señal final BUY/SELL", group=grpMEC)
mostrarZonaBusquedaMEC = input.bool(false, "Sombrear zona de búsqueda de Continuación (debug)", group=grpMEC)
UMBRAL_QUIEBRE = input.float(0.00005, "Umbral mínimo de quiebre/Continuación (rango de precios redondea a 2 decimales)", minval=0, maxval=0.001, step=0.00001, group=grpMEC)

var bool huboPullbackEnBusqueda = false
var float extremoQuiebre = na
var bool mecListo = false

// "or na(extremoQuiebre)" cubre el primerísimo quiebre de la sesión: viniendo
// de tendencia "indefinida" (nunca hubo un lado opuesto establecido),
// esCambioEstructuraAlto/Bajo da false, pero igual hay que inicializar el
// nivel esa primera vez o el motor nunca arrancaría.
//
// El reset toma el máximo/mínimo de las últimas 4 velas M1 (esta + 3 para
// atrás), no solo la vela actual -- porque la vela M3 que contiene el
// quiebre real recién queda "cerrada y reconocida" por el código hasta 3
// velas M1 después (la estructura M3 agrupa de a 3 minutos, y solo se
// procesa cuando el gráfico M1 llega al siguiente bloque). Sin este
// colchón, `extremoQuiebre` arrancaba con el mínimo/máximo de la vela
// donde el código RECONOCE el quiebre (tarde), no de la vela que
// realmente lo originó -- un nivel mucho más fácil de superar, que
// generaba señales falsas. Caso real que lo destapó: SELL 07/09 20:47 --
// el quiebre real fue en la vela de las 20:43 (mínimo 4.418,830), pero el
// código recién lo reconoció en la de las 20:45 (mínimo 4.420,620,
// bastante más alto), y la vela de las 20:47 superaba ese segundo nivel
// sin superar el real.
if quiebreAlto and (esCambioEstructuraAlto or na(extremoQuiebre))
    huboPullbackEnBusqueda := false
    extremoQuiebre := math.max(math.max(high, high[1]), math.max(high[2], high[3]))
    mecListo := false

if quiebreBajo and (esCambioEstructuraBajo or na(extremoQuiebre))
    huboPullbackEnBusqueda := false
    extremoQuiebre := math.min(math.min(low, low[1]), math.min(low[2], low[3]))
    mecListo := false

esVelaAFavor = false
esVelaEnContra = false
superaNivelAhora = false

if tendencia != "indefinida" and not na(extremoQuiebre)
    esVelaAFavor := tendencia == "alcista" ? close > open : close < open
    esVelaEnContra := tendencia == "alcista" ? close < open : close > open

    umbral = tendencia == "alcista" ? extremoQuiebre * (1 + UMBRAL_QUIEBRE) : extremoQuiebre * (1 - UMBRAL_QUIEBRE)
    superaNivelAhora := tendencia == "alcista" ? close > umbral : close < umbral

    if esVelaEnContra
        huboPullbackEnBusqueda := true

    // una vez que ya hubo al menos 1 vela de pullback, la primera vela a
    // favor que supera el nivel vigente confirma la Continuación
    if huboPullbackEnBusqueda and esVelaAFavor and superaNivelAhora
        mecListo := true

    // el nivel se extiende SIEMPRE con la mecha de esta vela, haya
    // superado o no -- pasa a ser el próximo "nivel a la izquierda" a
    // batir, incluso después de que mecListo ya esté en true
    extremoQuiebre := tendencia == "alcista" ? math.max(extremoQuiebre, high) : math.min(extremoQuiebre, low)

esperandoContinuacion = tendencia != "indefinida" and not mecListo

// -- Señal MEC "en bruto": todavía sin SL/TP, sin
//    control de "una señal por vela hasta invalidarse" -- eso es el próximo
//    incremento de la Fase 3. Esto es solo para validar el motor MEC.
mecBuyBruto  = mecListo and tendencia == "alcista" and superaNivelAhora and (candidataEnvolventeBuy  or esStartBuy)
mecSellBruto = mecListo and tendencia == "bajista" and superaNivelAhora and (candidataEnvolventeSell or esStartSell)

// filtro de sesión: el motor MEC sigue corriendo las 24hs por detrás (para no
// perder el hilo de la estructura), pero la señal solo se MUESTRA dentro de
// Pre-NY / Asia
mecBuySenal  = mecBuyBruto  and enSesionOperativa
mecSellSenal = mecSellBruto and enSesionOperativa

// bgcolor() no puede llamarse dentro de un `if` en Pine -- la condicionalidad
// va en la expresión de color, no envolviendo la llamada
bgcolor(mostrarZonaBusquedaMEC and esperandoContinuacion ? color.new(color.yellow, 85) : na, title="Esperando Continuación MEC (debug)")

// ---------------------------- CARTEL DE SEÑAL (nube gris claro, solo BUY/SELL) ----------------------------
// Nube minimalista: fondo gris claro, texto blanco en mayúsculas. BUY debajo
// de la vela de entrada (apunta hacia arriba), SELL arriba (apunta hacia
// abajo). Sin ficha de datos -- eso era contexto para mí, no parte del
// diseño final del cartel.
//
// barstate.isconfirmed: el cartel SOLO se dibuja en la ejecución final y
// confirmada de la vela M1 (cuando ya cerró), nunca en un tick intermedio
// mientras la vela todavía se está formando. Sin este freno, TradingView
// recalcula el script en cada tick de la vela en curso -- si en algún tick
// intermedio la vela luce momentáneamente como una envolvente/Start válida
// y el precio se revierte antes de que cierre el minuto, quedaría una
// etiqueta fantasma dibujada que Pine no borra solo. El patrón envolvente/
// Start se define con el open/close/high/low FINAL de la vela, así que no
// existe forma honesta de confirmarlo antes de que esa vela cierre.
colorCartel = color.new(color.silver, 0)

if mostrarSenalMEC and mecBuySenal and barstate.isconfirmed
    label.new(bar_index, low, "BUY", style=label.style_label_up, color=colorCartel, textcolor=color.white, size=size.normal)

if mostrarSenalMEC and mecSellSenal and barstate.isconfirmed
    label.new(bar_index, high, "SELL", style=label.style_label_down, color=colorCartel, textcolor=color.white, size=size.normal)

// ============================================================================
// SECCIÓN 7 — PANEL DE ESTADO
// ============================================================================
var table panel = table.new(position.top_right, 1, 2, border_width=1)
if barstate.islast
    table.cell(panel, 0, 0, tendencia == "alcista" ? "Uptrend (BUY)" : tendencia == "bajista" ? "Downtrend (SELL)" : "Undefined", text_color=color.white, bgcolor=tendencia == "alcista" ? color.new(color.green, 40) : tendencia == "bajista" ? color.new(color.red, 40) : color.new(color.gray, 40))
    table.cell(panel, 0, 1, mecListo ? "MEC ready" : esperandoContinuacion ? "Waiting for MEC" : "No Entry", text_color=color.white, bgcolor=mecListo ? color.new(color.teal, 40) : esperandoContinuacion ? color.new(color.orange, 40) : color.new(color.gray, 70))
