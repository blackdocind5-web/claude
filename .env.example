# ============================================================
# JARVIS — Variables de entorno
# Copiá este archivo como .env y completá tus valores reales
# NUNCA subas el .env a GitHub (ya está en .gitignore)
# ============================================================

# --- EMAIL (para envío de reportes) ---
# Usá una cuenta Gmail con "contraseña de aplicación" habilitada
# Guía: https://support.google.com/accounts/answer/185833
JARVIS_EMAIL_FROM=tu_email@gmail.com
JARVIS_EMAIL_PASSWORD=tu_contraseña_de_aplicacion
JARVIS_EMAIL_TO=tu_email@gmail.com
JARVIS_EMAIL_SMTP=smtp.gmail.com
JARVIS_EMAIL_PORT=587

# --- ALPHA VANTAGE (noticias históricas + sentimiento) ---
# Plan gratuito disponible en https://www.alphavantage.co/support/#api-key
# Sin esta clave, fetch_news.py usa solo Yahoo Finance (menos historial)
ALPHA_VANTAGE_KEY=

# --- CONFIGURACIÓN GENERAL ---
JARVIS_CURRENCY=USD
JARVIS_LANGUAGE=es
JARVIS_CHART_PERIOD=6mo
